# Auto detect text files and normalize end of lines to LF (\n)
* text=auto eol=lf

# Unified-diff context preserves upstream blank lines and tab indentation.
tools/driver_patches/pglast-8.5-native-options.patch whitespace=-blank-at-eol,-space-before-tab

# Preserve the approved DDN release bytes. Upstream distributions contain a
# deliberate space-only separator line and are verified by SHA-256 manifest.
web/pgadmin/static/vendor/ddn/**/*.js whitespace=-blank-at-eol
web/pgadmin/static/vendor/ddn/**/*.html whitespace=-blank-at-eol

# Preserve the signed AI/Discovery specification Markdown bytes. The package
# uses CommonMark two-space hard line breaks and is verified by SHA-256.
web/pgadmin/static/js/cdeadmin_ui/specifications/ai_discovery_zero_grey/*.md whitespace=-blank-at-eol
web/pgadmin/static/js/cdeadmin_ui/specifications/ai_discovery_zero_grey/**/*.md whitespace=-blank-at-eol

# Unified patches preserve a single context prefix on otherwise blank lines.
tools/driver_patches/mysql-connector-python-26.7.0-query-attributes.patch whitespace=-blank-at-eol

# Native GPL source patches retain upstream blank context lines.
tools/native/mysql_physical/raw-reader.patch whitespace=-blank-at-eol
