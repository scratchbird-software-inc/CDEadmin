# Copy to .env.dev and adjust, then:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up --build

CDEADMIN_HTTP_PORT=5051
CDEADMIN_DEFAULT_EMAIL=developer@example.com
CDEADMIN_DEFAULT_PASSWORD=CDEadminDev-2026!

# Set to 1 to also install tools/reference_engine_demos/requirements.txt in the image.
INSTALL_DEMO_REQUIREMENTS=0

# Node heap (MiB) for webpack during `docker compose build`; needs headroom in Docker Desktop RAM.
NODE_MAX_OLD_SPACE_SIZE=8192

MONGODB_PORT=27017
