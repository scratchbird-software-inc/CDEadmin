+/* ScratchRobin opt-in: preserve SQL temporal values outside Python's calendar.
+   This affects only query cursors explicitly opting in, not catalog consumers. */
+static int cdeadmin_temporal_type(enum enum_field_types type)
+{
+    return type == MYSQL_TYPE_DATE || type == MYSQL_TYPE_DATETIME ||
+           type == MYSQL_TYPE_TIMESTAMP || type == MYSQL_TYPE_TIME;
+}
+
+static PyObject *cdeadmin_binary_temporal(MYSQL_FIELD *field, unsigned char **row)
+{
+    unsigned long len= mysql_net_field_length(row);
+    unsigned char *p= *row;
+    unsigned int year= 0, month= 0, day= 0, hour= 0, minute= 0, second= 0;
+    unsigned int microsecond= 0, negative= 0;
+    char result[64], fraction[8];
+    unsigned int precision= field->decimals <= 6 ? field->decimals : 6;
+    if (field->type == MYSQL_TYPE_TIME)
+    {
+        if (len != 0 && len != 8 && len != 12)
+            goto invalid;
+        if (len)
+        {
+            negative= p[0];
+            hour= uint4korr(p + 1) * 24 + p[5];
+            minute= p[6]; second= p[7];
+            if (len == 12) microsecond= uint4korr(p + 8);
+        }
+        snprintf(result, sizeof(result), "%s%02u:%02u:%02u",
+                 negative ? "-" : "", hour, minute, second);
+    }
+    else
+    {
+        if (len != 0 && len != 4 && len != 7 && len != 11)
+            goto invalid;
+        if (len)
+        {
+            year= uint2korr(p); month= p[2]; day= p[3];
+            if (len >= 7) { hour= p[4]; minute= p[5]; second= p[6]; }
+            if (len == 11) microsecond= uint4korr(p + 7);
+        }
+        if (field->type == MYSQL_TYPE_DATE)
+        {
+            precision= 0;
+            snprintf(result, sizeof(result), "%04u-%02u-%02u", year, month, day);
+        }
+        else
+            snprintf(result, sizeof(result), "%04u-%02u-%02u %02u:%02u:%02u",
+                     year, month, day, hour, minute, second);
+    }
+    if (precision)
+    {
+        snprintf(fraction, sizeof(fraction), ".%06u", microsecond);
+        fraction[precision + 1]= 0;
+        strncat(result, fraction, sizeof(result) - strlen(result) - 1);
+    }
+    *row+= len;
+    return PyUnicode_FromString(result);
+invalid:
+    PyErr_SetString(PyExc_ValueError, "Invalid native temporal field length");
+    return NULL;
+}
