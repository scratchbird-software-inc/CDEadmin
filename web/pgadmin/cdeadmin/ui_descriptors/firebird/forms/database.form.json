      "tab": "Options",
      "control": "boolean",
      "required": false,
      "default": true
    },
    {
      "field_id": "reserve_space",
      "label": "Reserve page space for record versions",
      "tab": "Options",
      "control": "boolean",
      "required": false,
      "default": true
    },
    {
      "field_id": "stored_page_buffers",
      "label": "Stored database page buffers",
      "tab": "Options",
      "control": "number",
      "required": false,
      "help": "Optional persistent database-header override. Zero uses the server default; nonzero values must be at least 50 and take precedence over attachment cache requests. 32-bit servers limit this to 131072; 64-bit servers to 2147483646. Allocation also depends on available memory."
    },
    {
      "field_id": "sweep_interval",
      "label": "Automatic sweep interval (transaction gap)",
      "tab": "Options",
      "control": "number",
      "required": false,
      "help": "Optional stored threshold in transaction numbers. Omission keeps the native default; zero disables automatic threshold-triggered sweeps, not manual sweep or garbage collection. Applies to the database being created."
    },
    {
      "field_id": "linger_seconds",
      "label": "Linger time in seconds",
      "tab": "Options",
      "control": "number",
      "required": false,
      "modes": [
        "alter"
      ]
    },
    {
      "field_id": "drop_linger",
      "label": "Drop the configured linger time",
      "tab": "Options",
      "control": "boolean",
      "required": false,
      "default": false,
      "modes": [
        "alter"
      ]
    },
    {
      "field_id": "default_sql_security",
      "label": "Default SQL security",
      "tab": "Options",
      "control": "select",
      "required": false,
      "options": [
        {
          "value": "DEFINER",
