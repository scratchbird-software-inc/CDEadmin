    {
      "field_id": "name",
      "label": "Function name",
      "tab": "General",
      "control": "text",
      "required": true,
      "help": "Legacy external functions execute native server code. The library must already be installed and permitted by Firebird UdfAccess; this task does not install code or change server security. Argument and return mechanisms must match the installed function ABI exactly. Prefer PSQL or UDR functions for new development.",
      "modes": [
        "create"
      ]
    },
    {
      "field_id": "entrypoint",
      "label": "Exported entry point",
      "tab": "General",
      "control": "text",
      "required": true,
      "help": "At most 255 UTF-8 bytes."
    },
    {
      "field_id": "module_name",
      "label": "Installed library",
      "tab": "General",
      "control": "text",
      "required": true,
      "help": "At most 255 UTF-8 bytes."
