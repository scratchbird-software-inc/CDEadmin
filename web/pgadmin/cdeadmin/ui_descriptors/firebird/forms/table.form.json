{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "firebird",
  "family": "table",
  "resource_kinds": [
    "table"
  ],
  "status": "complete",
  "engine_tab_title": "Firebird",
  "omitted_tabs": [
    {
      "tab": "Partitions",
      "reason": "no partitioning"
    }
  ],
  "gaps": [
    {
      "concept": "Partitions tab",
      "reason": "omit: Firebird has no partitioning; list under omitted_tabs when completed"
    }
