  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true
    },
    {
      "field_id": "table_type",
      "label": "Table kind",
      "tab": "General",
      "control": "select",
      "required": true,
      "default": "PERSISTENT",
      "options": [
        {
          "value": "PERSISTENT",
          "label": "Persistent"
        },
        {
          "value": "GLOBAL TEMPORARY",
          "label": "Global Temporary"
        },
        {
          "value": "EXTERNAL",
          "label": "External"
        }
      ],
      "record_derive": {
        "cases": [
          {
            "key": "external_file",
            "truthy": true,
            "value": "EXTERNAL"
          },
          {
            "key": "relation_type",
            "equals": 4,
            "value": "GLOBAL TEMPORARY"
          },
          {
            "key": "relation_type",
            "equals": 5,
            "value": "GLOBAL TEMPORARY"
          }
        ],
        "default": "PERSISTENT"
      }
    },
    {
      "field_id": "on_commit",
      "label": "Temporary row retention",
      "tab": "General",
      "control": "select",
      "required": true,
      "default": "DELETE ROWS",
      "options": [
        {
          "value": "DELETE ROWS",
          "label": "Delete Rows"
        },
        {
          "value": "PRESERVE ROWS",
          "label": "Preserve Rows"
        }
      ],
      "visible_when": {
        "field": "table_type",
        "equals": "GLOBAL TEMPORARY"
      },
      "record_derive": {
        "cases": [
          {
            "key": "relation_type",
            "equals": 4,
            "value": "PRESERVE ROWS"
          }
        ],
        "default": "DELETE ROWS"
      }
    },
    {
      "field_id": "external_file",
      "label": "External filename on the server",
      "tab": "General",
      "control": "text",
      "required": true,
      "help": "The server must permit this path through ExternalFileAccess. This is not a client file upload. External row inserts cannot be rolled back. UPDATE and DELETE are unavailable; DROP leaves the file intact.",
      "visible_when": {
        "field": "table_type",
        "equals": "EXTERNAL"
      }
    },
