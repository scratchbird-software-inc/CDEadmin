{
  "schema": "cdeadmin.ui-security.v1",
  "engine": "firebird",
  "status": "complete",
  "notes": "Users are server-wide (security database); roles live in each database. One role form serves user, role and grant through its variant select. Column grants accept only UPDATE and REFERENCES. Roster columns are added when the provider resources' attributes are verified.",
  "principals": [
    {
      "kind": "user",
      "label": "User",
      "plural_label": "Users",
      "scope": "server",
      "identity": [
        "name"
      ],
      "variant": {
        "field_id": "variant",
        "value": "user"
      }
    },
    {
      "kind": "role",
      "label": "Role",
      "plural_label": "Roles",
      "scope": "database",
      "identity": [
        "name"
      ],
      "variant": {
        "field_id": "variant",
        "value": "role"
      }
    }
  ],
  "membership": {
    "kind": "role",
    "admin_option": true,
    "default_role": true,
    "listing": {
      "native_field": "memberships",
      "columns": [
        {
          "field": "grantee",
          "label": "Member"
        },
        {
          "field": "default_role",
          "label": "Default role",
          "boolean": true
        },
        {
          "field": "grant_option",
          "label": "Admin option",
          "equals": 2
        },
        {
          "field": "grantor",
          "label": "Granted by"
        }
      ]
    }
  },
  "grants": {
    "grant_kind": "privilege",
    "system_privileges": "system_privileges",
    "object_privileges": "privileges",
    "grantable_kinds": "grantable_kinds",
    "column_privileges": {
      "table": [
        "UPDATE",
        "REFERENCES"
      ],
      "view": [
        "UPDATE",
        "REFERENCES"
      ]
    },
    "grant_option": true,
    "granted_by": true,
    "listing": {
      "object_field": "object_name",
      "grantee_field": "grantee",
      "grantee_kind_field": "user_type",
      "grantee_kinds": {
        "8": "USER",
        "13": "ROLE"
      },
      "privilege_field": "privilege",
      "privilege_codes": {
        "S": "SELECT",
        "I": "INSERT",
        "U": "UPDATE",
        "D": "DELETE",
        "R": "REFERENCES",
        "X": "EXECUTE",
        "G": "USAGE"
      },
      "column_field": "field",
      "grant_option_field": "grant_option",
      "grant_option_equals": 1,
      "grantor_field": "grantor"
    }
  },
  "requires": {
    "inspect": "verified",
    "mutate": "verified"
  }
}
