        "field": "variant",
        "equals": "user"
      },
      "help": "Change it with Set user activation. Drop user deactivates: immudb 1.11.0 keeps every user (multidb_handler.go DropUser sets it inactive)."
    },
    {
      "field_id": "createdby",
      "label": "Created by",
      "tab": "General",
      "control": "text",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "visible_when": {
        "field": "variant",
        "equals": "user"
      }
    },
    {
