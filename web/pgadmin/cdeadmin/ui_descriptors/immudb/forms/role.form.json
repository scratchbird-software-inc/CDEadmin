      "modes": [
        "alter"
      ],
      "visible_when": {
        "field": "variant",
        "equals": "user"
      },
      "help": "Granted and revoked with the permission operations; * is every database.",
      "columns": [
        {
          "field_id": "database",
          "label": "Database",
          "control": "text"
        },
        {
          "field_id": "permission",
          "label": "Permission",
          "control": "text"
        }
      ]
    },
    {
      "field_id": "sql_privileges",
      "label": "SQL privileges",
      "tab": "Privileges",
      "control": "grid",
