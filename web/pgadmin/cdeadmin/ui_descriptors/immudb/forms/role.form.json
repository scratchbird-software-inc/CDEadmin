      "options": [
        {
          "value": "user",
          "label": "User"
        },
        {
          "value": "grant",
          "label": "Database permission"
        }
      ]
    },
    {
      "field_id": "name",
      "label": "Username",
      "tab": "General",
      "control": "text",
      "required": true,
      "editable_after_create": false,
      "visible_when": {
        "field": "variant",
        "equals": "user"
      }
    },
    {
      "field_id": "password",
      "label": "Password",
      "tab": "General",
      "control": "password",
      "required": true,
      "group": "Authentication",
