      "tab": "Membership",
      "reason": "immudb has users only: no roles or role membership"
    }
  ],
  "gaps": [
    {
      "concept": "Renaming a user",
      "reason": "No statement in immudb 1.11.0",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "Per-table privileges",
      "reason": "immudb grants SQL privileges per database (GRANT ... ON DATABASE)",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "Deleting a user",
      "reason": "immudb keeps every user; DROP USER deactivates it (live and source, 1.11.0)",
      "tracking": "postgresql-wire-parity"
    }
  ],
  "fields": [
    {
