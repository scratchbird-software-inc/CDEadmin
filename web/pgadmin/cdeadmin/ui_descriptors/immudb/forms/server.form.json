{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "immudb",
  "family": "server",
  "resource_kinds": [
    "server"
  ],
  "status": "draft",
  "engine_tab_title": "immudb",
  "omitted_tabs": [],
  "gaps": [
    {
      "concept": "server.keepalives",
      "reason": "Live round trip failed 2026-11-04 on the pinned immudb 1.11.0 demo: the contract default keepalives=true reaches libpq as 'True' ('invalid integer value \"True\" for connection option \"keepalives\"'). Predates this form: the legacy registration route carries the same default."
    },
    {
      "concept": "server.kind",
      "reason": "Not reachable yet: immudb declares its 'server' resource kind in the engine_object family with its own operations (health, load_database). Serving this form needs that kind in the server family, which would change how the tree opens immudb server nodes; left unchanged pending a decision."
    }
  ],
