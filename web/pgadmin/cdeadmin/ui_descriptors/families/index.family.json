{
  "schema": "cdeadmin.ui-family.v1",
  "family": "index",
  "title": "Index",
  "tabs": [
    {
      "tab": "General",
      "primitive": "group",
      "required": true,
      "fields": [
        {
          "field_id": "name",
          "label": "Name",
          "control": "text",
          "required": true
        },
        {
          "field_id": "table",
          "label": "Table",
          "control": "reference",
          "reference_kind": "table",
          "required": true
        },
        {
          "field_id": "unique",
          "label": "Unique",
          "control": "boolean"
        },
        {
          "field_id": "columns",
          "label": "Columns",
          "control": "grid",
          "required": true,
          "columns": [
            {
              "field_id": "column",
              "label": "Column",
              "control": "select",
              "option_values_path": [
                "target",
                "columns"
              ]
            },
            {
              "field_id": "expression",
              "label": "Expression",
              "control": "code",
              "language": "sql"
            },
            {
              "field_id": "sort_order",
              "label": "Order",
              "control": "select",
              "options": [
                {
                  "value": "asc",
                  "label": "Ascending"
                },
                {
                  "value": "desc",
                  "label": "Descending"
                }
              ]
            },
            {
              "field_id": "nulls",
              "label": "Nulls",
              "control": "select",
              "options": [
                {
                  "value": "default",
                  "label": "Default"
                },
                {
                  "value": "first",
                  "label": "First"
                },
                {
                  "value": "last",
                  "label": "Last"
                }
              ]
            },
            {
              "field_id": "collation",
              "label": "Collation",
              "control": "select",
              "option_values_path": [
                "dialect",
                "collations"
              ]
            },
            {
              "field_id": "opclass",
              "label": "Operator class",
              "control": "text"
            }
          ]
        },
        {
          "field_id": "where",
          "label": "Condition (partial index)",
          "control": "code",
          "language": "sql"
        },
        {
          "field_id": "comment",
          "label": "Comment",
          "control": "text"
        }
      ]
    },
    {
      "tab": "Options",
      "primitive": "group",
      "required": false,
      "fields": [
        {
          "field_id": "method",
          "label": "Method / kind",
          "control": "select",
          "option_values_path": [
            "dialect",
            "index_methods"
          ]
        },
        {
          "field_id": "include",
          "label": "Included columns",
          "control": "multiselect",
          "option_values_path": [
            "target",
            "columns"
          ]
        },
        {
          "field_id": "fillfactor",
          "label": "Fill factor",
          "control": "number"
        },
        {
          "field_id": "concurrent",
          "label": "Build concurrently",
          "control": "boolean"
        },
        {
          "field_id": "tablespace",
          "label": "Tablespace",
          "control": "select",
          "option_values_path": [
            "catalog",
            "tablespaces"
          ]
        }
      ]
    },
    {
      "tab": "Engine",
      "primitive": "group",
      "required": false
    },
    {
      "tab": "Dependencies",
      "primitive": "readonly_grid",
      "required": false,
      "nested": [
        {
          "name": "Depends on",
          "grid_columns": [
            {
              "field_id": "kind",
              "label": "Kind",
              "control": "text",
              "readonly": true
            },
            {
              "field_id": "name",
              "label": "Name",
              "control": "text",
              "readonly": true
            }
          ]
        },
        {
          "name": "Dependents",
          "grid_columns": [
            {
              "field_id": "kind",
              "label": "Kind",
              "control": "text",
              "readonly": true
            },
            {
              "field_id": "name",
              "label": "Name",
              "control": "text",
              "readonly": true
            }
          ]
        }
      ]
    },
    {
      "tab": "Statistics",
      "primitive": "readonly_groups",
      "required": false
    },
    {
      "tab": "SQL",
      "primitive": "sql_preview",
      "required": true,
      "notes": "Read-only. Create mode: full native DDL from the provider plan. Alter mode: the ALTER set. Replaces the confirm-step preview."
    }
  ]
}
