{
  "schema": "cdeadmin.ui-security.v1",
  "engine": "mysql",
  "status": "draft",
  "notes": "Accounts and roles are both identified by name and host, and the server keeps one catalog for both: it does not record whether an account was created as a role, so the manager shows one Accounts roster, marks accounts the server reports as locked or used as a role, and offers New role as a creation action. One role form serves user, role and grant through its variant select. The previous manager compiler also allowed REFERENCES on view columns, which this engine's privilege list does not offer; it is not declared here. Grants are keyed by scope: the listing reads database, table or column, and routine rows by the kind of object viewed, and the Accounts view shows every grant the selected account holds, global ones included. A grantee is one account string, so the grant dialog's user and host grid is filled by splitting it. Verified live against MySQL 9.7.0 (see ui_unification_status.rst); status stays draft pending the owner's go-ahead.",
  "principals": [
    {
      "kind": "user",
      "label": "Account",
      "plural_label": "Accounts",
      "scope": "server",
      "identity": [
        "name",
        "host"
      ],
      "variant": {
        "field_id": "variant",
        "value": "user"
      },
      "roster": {
        "markers": [
          {
            "label": "Locked",
            "field": "account_locked",
            "equals": "Y"
          },
          {
            "label": "Used as a role",
            "field": "role_usage_observed",
            "equals": true
          }
        ]
      }
    },
    {
      "kind": "role",
      "label": "Role",
      "plural_label": "Roles",
      "scope": "server",
      "identity": [
        "name",
        "host"
      ],
      "variant": {
        "field_id": "variant",
        "value": "role"
      },
      "roster": {
        "merged_into": "user"
      }
    }
  ],
  "membership": {
    "kind": "role",
    "admin_option": true,
    "default_role": true,
    "listing": {
      "native_field": "members",
      "title": "Members",
      "columns": [
        {
          "field": "principal",
          "label": "Member"
        },
        {
          "field": "admin_option",
          "label": "Admin option",
          "boolean": true
        }
      ]
    },
    "member_of_listing": {
      "native_field": "member_of",
      "title": "Roles held",
      "columns": [
        {
          "field": "role",
          "label": "Role"
        },
        {
          "field": "admin_option",
          "label": "Admin option",
          "boolean": true
        },
        {
          "field": "default_role",
          "label": "Default role",
          "boolean": true
        }
      ]
    }
  },
  "grants": {
    "grant_kind": "privilege",
    "status": "draft",
    "system_privileges": "system_privileges",
    "object_privileges": "privileges",
    "grantable_kinds": "grantable_kinds",
    "column_privileges": {
      "table": [
        "SELECT",
        "INSERT",
        "UPDATE",
        "REFERENCES"
      ],
      "view": [
        "SELECT",
        "INSERT",
        "UPDATE"
      ]
    },
    "grant_option": true,
    "listing": {
      "scope_field": "scope",
      "kinds": {
        "database": {
          "scopes": [
            "database"
          ],
          "fields": [
            "database"
          ]
        },
        "table": {
          "scopes": [
            "table",
            "column"
          ],
          "fields": [
            "database",
            "table_name"
          ]
        },
        "view": {
          "scopes": [
            "table",
            "column"
          ],
          "fields": [
            "database",
            "table_name"
          ]
        },
        "procedure": {
          "scopes": [
            "routine"
          ],
          "fields": [
            "database",
            "routine_name"
          ],
          "where": {
            "routine_type": "PROCEDURE"
          }
        },
        "function": {
          "scopes": [
            "routine"
          ],
          "fields": [
            "database",
            "routine_name"
          ],
          "where": {
            "routine_type": "FUNCTION"
          }
        }
      },
      "grantee_field": "grantee",
      "grantee_template": "'{name}'@'{host}'",
      "privilege_field": "privilege",
      "column_field": "column_name",
      "grant_option_field": "is_grantable",
      "grant_option_equals": "YES",
      "held": true
    },
    "dialog": {
      "object_type": "object_type",
      "object": "object",
      "qualifiers": [
        "database"
      ],
      "object_by_kind": {
        "database": "database"
      },
      "row": {
        "grantee_grid": {
          "field": "grantees",
          "user": "user",
          "host": "host"
        },
        "privileges_field": "privileges",
        "privilege_key": "name",
        "columns_key": "columns"
      }
    }
  },
  "requires": {
    "inspect": "verified",
    "mutate": "verified"
  }
}
