{
  "schema": "cdeadmin.ui-security.v1",
  "engine": "mysql",
  "status": "draft",
  "notes": "Accounts and roles are both identified by name and host. One role form serves user, role and grant through its variant select. The previous manager compiler also allowed REFERENCES on view columns, which this engine's privilege list does not offer; it is not declared here.",
  "principals": [
    {
      "kind": "user",
      "label": "User",
      "plural_label": "Users",
      "scope": "server",
      "identity": [
        "name",
        "host"
      ],
      "variant": {
        "field_id": "variant",
        "value": "user"
      }
    },
    {
      "kind": "role",
      "label": "Role",
      "plural_label": "Roles",
      "scope": "server",
      "identity": [
        "name",
        "host"
      ],
      "variant": {
        "field_id": "variant",
        "value": "role"
      }
    }
  ],
  "membership": {
    "kind": "role",
    "admin_option": true,
    "default_role": true
  },
  "grants": {
    "grant_kind": "privilege",
    "system_privileges": "system_privileges",
    "object_privileges": "privileges",
    "grantable_kinds": "grantable_kinds",
    "column_privileges": {
      "table": [
        "SELECT",
        "INSERT",
        "UPDATE",
        "REFERENCES"
      ],
      "view": [
        "SELECT",
        "INSERT",
        "UPDATE"
      ]
    },
    "grant_option": true
  },
  "requires": {
    "inspect": "verified",
    "mutate": "verified"
  }
}
