{
  "schema": "cdeadmin.ui-operations.v1",
  "engine": "mysql",
  "operations": [
    {
      "operation_id": "install_user_key_functions",
      "resource_kind": "server",
      "title": "Install key functions",
      "menu": {
        "category": "security",
        "order": 100
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "typed_name",
      "groups": [
        "Native library",
        "Key",
        "Confirmation"
      ],
      "fields": [
        {
          "field_id": "library",
          "label": "Library",
          "control": "text",
          "required": true,
          "group": "Native library",
          "default": "keyring_udf.so",
          "help": "Library basename installed in the database server plugin directory. A keyring service must already be active."
        },
        {
          "field_id": "trusted_library",
          "label": "Trust this server library",
          "control": "boolean",
          "required": true,
          "group": "Native library",
          "default": false,
          "help": "Authorizes the native plugin and six function definitions. Existing matching definitions are preserved."
        },
        {
          "field_id": "confirmation",
          "label": "Server name",
          "control": "text",
          "required": true,
          "group": "Confirmation",
          "help": "Type the selected server display name."
        }
      ],
      "notes": "Provider plan/validate/apply backend operation. The shared operation dialog supplies its SQL tab. Draft pending front-end family rendering and presentation acceptance; no legacy form or panel is introduced. Stable SR-F allocation remains with the front-end registry owner. Owner Decision10: user-key results are metadata-only for beta (type and byte length); raw-key retrieval/export is outside this beta scope. No key material is returned in public plans, receipts or downloads."
    },
    {
