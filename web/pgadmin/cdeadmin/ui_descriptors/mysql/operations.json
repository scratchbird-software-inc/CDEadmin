        },
        {
          "field_id": "member_host",
          "label": "Recipient host",
          "control": "text",
          "default": "%",
          "required": true,
          "group": "Membership"
        },
        {
          "field_id": "mode",
          "label": "Default role set",
          "control": "select",
          "default": "SELECTED",
          "options": [
            {
              "value": "SELECTED",
              "label": "Selected"
            },
            {
              "value": "ALL",
              "label": "All"
            },
            {
              "value": "NONE",
              "label": "None"
            }
          ],
          "group": "Membership",
          "help": "Replaces the native default-role set; does not grant missing membership."
        },
        {
          "field_id": "roles",
          "label": "Default roles",
          "control": "grid",
          "columns": [
            {
              "field_id": "user",
              "label": "User",
              "control": "text",
              "required": true
            },
            {
              "field_id": "host",
              "label": "Host",
              "control": "text"
            }
          ],
          "visible_when": {
            "field": "mode",
            "equals": "SELECTED"
          },
          "help": "Optional complete replacement list. Omit it to use the selected role; a supplied list must contain every default role to retain."
        },
        {
          "field_id": "confirmation",
          "label": "Role name",
          "control": "text",
          "required": true,
          "group": "Confirmation"
