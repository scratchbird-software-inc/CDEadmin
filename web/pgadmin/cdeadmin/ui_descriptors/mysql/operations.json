          "label": "Recipient user",
          "control": "text",
          "default": "",
          "group": "Membership",
          "help": "An explicit empty user names the native anonymous account; MySQL decides whether it can receive this role."
        },
        {
          "field_id": "member_host",
          "label": "Recipient host",
          "control": "text",
          "default": "%",
          "required": true,
          "group": "Membership"
        },
        {
          "field_id": "admin_option",
          "label": "Allow delegation",
          "control": "boolean",
          "default": false,
          "group": "Membership"
        },
        {
          "field_id": "confirmation",
          "label": "Role name",
          "control": "text",
          "required": true,
          "group": "Confirmation"
        }
      ],
      "notes": "Binds the existing native role membership operation with separate user and host identities. Shared family grid dispatch remains Decision9; no new legacy form is generated."
    },
