  {"field_id":"temporary","label":"Temporary","control":"boolean","tab":"General","default":false,"modes":["create"],"help":"Creates on the reviewed retained session without committing. The table lasts until DROP TEMPORARY TABLE or native session closure. Session binding needs the shared editor integration."},
