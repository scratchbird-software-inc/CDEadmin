 "omitted_tabs": [],
 "gaps": [
  {"concept":"Separate column length/precision/scale/unsigned/identity/charset/collation/generated/comment controls","reason":"The column record compiler consumes only name, type, nullable, default, unique and primary_key. Other native clauses currently require the full type declaration, not the drafted standalone field ids.","tracking":"INV-MYSQL"},
  {"concept":"Partitions editor","reason":"partition_by and add_partitions are operation ids with partition_clause/definitions/count drafts, not nested properties accepted by table.create. Decision 4 defaults to the Partitions tab; the typed operation-to-grid integration remains open.","tracking":"INV-MYSQL"},
  {"concept":"ALTER grid diff and online algorithm/lock","reason":"The current alter compiler accepts add_columns/drop_columns/rename_columns; it does not accept create-grid columns or alter_algorithm/alter_lock. The existing controlled-change workflow is separate.","tracking":"INV-MYSQL"},
  {"concept":"Object privileges grid application","reason":"privilege.grant is an operation address, not a table.create draft property. Cross-operation diff dispatch needs the shared shell contract.","tracking":"INV-MYSQL"},
  {"concept":"MERGE member selection","reason":"mysql_table_options.union accepts arrays of identifier-path arrays, not selected reference strings or grid records. Decision 9 records the missing value projection.","tracking":"INV-MYSQL"},
  {"concept":"SECONDARY_ENGINE explicit NULL and JSON-attribute scalar variants","reason":"The backend accepts None for SECONDARY_ENGINE and arbitrary JSON for engine attributes. This draft exposes named text and key/value objects only; the schema has no explicit nullable/text or nested typed JSON value projection.","tracking":"INV-MYSQL"},
  {"concept":"Primary engine attributes outside beta profile","reason":"Core SQL hooks require HTON_SUPPORTS_ENGINE_ATTRIBUTE. No implementation in the audited MySQL9.7 Community engine sources advertises it; release InnoDB/MyISAM/MEMORY reject index use with native error3981. Debug simulation is not product support. A separately available implementation and native qualification are required before surfacing this field. Secondary-engine attribute metadata is separate.","tracking":"MY-POST-BETA-PRIMARY-ENGINE-ATTRIBUTES"}
 ],
 "notes": "Typed create bindings include retained temporary tables, native FK actions and CHECK enforcement. Unsupported property projections stay in gaps. Canonical read-only tabs and SQL come from the shared shell; draft is not presentation acceptance.",
