  "gaps": [
    {
      "concept": "Typed scalar and array engine attributes",
      "reason": "The backend accepts native JSON values; keyvalue represents object roots. Other root shapes need the declared projection contract in Decision 9."
    },
    {
      "concept": "Existing option projections",
      "reason": "Parser, key block size and engine attributes remain preserved in native owning-table DDL. Structured default-value projection for these fields is not yet available."
    },
    {
      "concept": "Definition changes",
      "reason": "MySQL has native rename and visibility operations, but no ALTER INDEX key-part definition. Existing table controlled-change/DDN workflows own native DROP/ADD definition changes; this form does not silently recreate an index."
    },
    {
      "concept": "Primary engine attributes outside beta profile",
      "reason": "Core SQL hooks require HTON_SUPPORTS_ENGINE_ATTRIBUTE. No implementation in the audited MySQL9.7 Community engine sources advertises it; release InnoDB/MyISAM/MEMORY reject index use with native error3981. Debug simulation is not product support. A separately available implementation and native qualification are required before surfacing this field. Secondary-engine attribute metadata is separate.",
      "tracking": "MY-POST-BETA-PRIMARY-ENGINE-ATTRIBUTES"
    }
  ],
