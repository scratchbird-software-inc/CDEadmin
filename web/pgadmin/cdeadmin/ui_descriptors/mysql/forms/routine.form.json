  "engine_tab_title": "MySQL",
  "omitted_tabs": [],
  "gaps": [
    {
      "concept": "Body and signature edits",
      "reason": "Native ALTER PROCEDURE/FUNCTION changes characteristics, not the signature, body, definer or determinism. Existing explicit DROP/CREATE and DDN workflows remain separate; the family never silently replaces a routine."
    },
    {
      "concept": "Privilege changes",
      "reason": "Privileges use separate native grant/revoke operations. Family grid diff dispatch remains Decision9."
    },
    {
      "concept": "Imported libraries and non-SQL runtimes",
      "reason": "Community can retain native library definitions; non-SQL execution depends on a separately implemented runtime. Closed Enterprise MLE execution remains post beta, not an emulated SQL routine."
    },
    {
      "concept": "Name changes",
      "reason": "Native event rename, including a move to another database, is a separate typed Maintenance operation until the shared family dispatch contract in Decision9 is available."
    }
  ],
