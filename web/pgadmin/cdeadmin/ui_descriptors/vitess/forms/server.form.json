  "omitted_tabs": [],
  "gaps": [
    {
      "concept": "server.failover",
      "reason": "Live round trip failed 2026-11-04 on the pinned Vitess 23.0.3 demo: an untouched Failover endpoints grid is sent as [] and kept in the route, and the MySQL-wire connector refuses an empty target list ('Select a bounded native failover target list'). Caused by the typed grid: the legacy JSON field sent '' and was dropped. Blocked on design open decision 20 (no per-field 'omit when empty')."
    }
  ],
