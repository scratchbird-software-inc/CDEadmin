{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "cockroachdb",
  "family": "sequence",
  "resource_kinds": [
    "sequence"
  ],
  "status": "complete",
  "engine_tab_title": "CockroachDB",
  "omitted_tabs": [],
  "gaps": [
    {
      "concept": "CYCLE",
      "reason": "Unimplemented in CockroachDB 26.1.3 (live)",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "Sequence comments",
      "reason": "COMMENT ON SEQUENCE is a syntax error on 26.1.3 (live)",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "Current value (setval)",
      "reason": "Runs on 26.1.3 but the record does not read the current value; Restart sets the next one",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "Temporary sequences",
      "reason": "Need the session opt-in experimental_enable_temp_tables",
      "tracking": "postgresql-wire-parity"
    }
  ],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true,
      "help": "Renaming runs ALTER SEQUENCE ... RENAME TO."
    },
    {
      "field_id": "parent",
      "label": "Schema",
      "tab": "General",
      "control": "reference",
      "reference_kind": "schema",
      "reference_value": "display_name",
      "editable_after_create": false
    },
    {
      "field_id": "owned_by",
      "label": "Owned by column",
      "tab": "General",
      "control": "text",
      "help": "schema.table.column (OWNED BY); dropping that column drops the sequence. Empty: OWNED BY NONE."
    },
    {
      "field_id": "data_type",
      "label": "Type",
      "tab": "General",
      "control": "select",
      "default": "INT8",
      "options": [
        {
          "value": "INT2",
          "label": "INT2"
        },
        {
          "value": "INT4",
          "label": "INT4"
        },
        {
          "value": "INT8",
          "label": "INT8"
        }
      ],
      "help": "AS type"
    },
    {
      "field_id": "start",
      "label": "Start",
      "tab": "General",
      "control": "number",
      "help": "START WITH"
    },
    {
      "field_id": "increment",
      "label": "Increment",
      "tab": "General",
      "control": "number",
      "help": "INCREMENT BY"
    },
    {
      "field_id": "minimum",
      "label": "Minimum",
      "tab": "General",
      "control": "number",
      "help": "MINVALUE; empty: NO MINVALUE"
    },
    {
      "field_id": "maximum",
      "label": "Maximum",
      "tab": "General",
      "control": "number",
      "help": "MAXVALUE; empty: NO MAXVALUE"
    },
    {
      "field_id": "cache",
      "label": "Cache",
      "tab": "General",
      "control": "number",
      "help": "CACHE: values reserved at a time"
    },
    {
      "field_id": "cache_scope",
      "label": "Cache scope",
      "tab": "General",
      "control": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Default (per node above 1)"
        },
        {
          "value": "PER NODE",
          "label": "Per node"
        },
        {
          "value": "PER SESSION",
          "label": "Per session"
        }
      ],
      "help": "PER NODE or PER SESSION CACHE. Leaving per session resets the cache first (CockroachDB ignores the change otherwise). A cache of 1 has no scope."
    },
    {
      "field_id": "restart",
      "label": "Restart with",
      "tab": "General",
      "control": "number",
      "modes": [
        "alter"
      ],
      "help": "RESTART WITH: the next value nextval returns. Leave empty to keep the current value."
    }
  ],
  "notes": "Hand-finished from providers/cockroachdb/sequences.py. The record reads SHOW CREATE ALL TABLES (pg_sequences reports bigint for every type) and OWNED BY from pg_depend. Round trip verified live on CockroachDB 26.1.3 by tools/tests/test_ui_descriptor_roundtrip_cockroachdb.py (2026-10-30)."
}
