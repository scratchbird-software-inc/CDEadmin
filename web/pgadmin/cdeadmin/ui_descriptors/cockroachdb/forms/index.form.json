{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "cockroachdb",
  "family": "index",
  "resource_kinds": [
    "index"
  ],
  "status": "complete",
  "engine_tab_title": "CockroachDB",
  "omitted_tabs": [],
  "gaps": [
    {
      "concept": "Index partitioning, zone configuration, scatter and split",
      "reason": "Separate operations, not editor fields",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "Changing keys, method, predicate or STORING",
      "reason": "No in-place statement on 26.1.3; drop and create",
      "tracking": "postgresql-wire-parity"
    }
  ],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true,
      "help": "Renaming runs ALTER INDEX ... RENAME TO."
    },
    {
      "field_id": "table",
      "label": "Table",
      "tab": "General",
      "control": "reference",
      "required": true,
      "reference_kind": "table",
      "reference_value": "display_path",
      "editable_after_create": false
    },
    {
      "field_id": "unique",
      "label": "Unique",
      "tab": "General",
      "control": "boolean",
      "default": false,
      "editable_after_create": false
    },
    {
      "field_id": "keys",
      "label": "Keys",
      "tab": "General",
      "control": "grid",
      "required": true,
      "reorderable": true,
      "editable_after_create": false,
      "help": "A column name or an expression such as lower(name). Keys cannot change in place; create a new index.",
      "columns": [
        {
          "field_id": "expression",
          "label": "Column or expression",
          "control": "text",
          "required": true
        },
        {
          "field_id": "direction",
          "label": "Direction",
          "control": "select",
          "options": [
            {
              "value": "",
              "label": "Default"
            },
            {
              "value": "ASC",
              "label": "Ascending"
            },
            {
              "value": "DESC",
              "label": "Descending"
            }
          ]
        }
      ]
    },
    {
      "field_id": "predicate",
      "label": "Partial index predicate",
      "tab": "General",
      "control": "code",
      "language": "sql",
      "editable_after_create": false,
      "help": "WHERE expression"
    },
    {
      "field_id": "comment",
      "label": "Comment",
      "tab": "General",
      "control": "text",
      "help": "COMMENT ON INDEX"
    },
    {
      "field_id": "method",
      "label": "Method",
      "tab": "Options",
      "control": "select",
      "default": "btree",
      "editable_after_create": false,
      "options": [
        {
          "value": "btree",
          "label": "B-tree"
        },
        {
          "value": "inverted",
          "label": "Inverted (GIN)"
        }
      ],
      "help": "Inverted indexes serve JSONB, arrays and trigram text (key expression with an operator class, e.g. name gin_trgm_ops)."
    },
    {
      "field_id": "storing",
      "label": "Stored columns",
      "tab": "Options",
      "control": "grid",
      "item_kind": "string",
      "editable_after_create": false,
      "help": "STORING (INCLUDE): extra columns kept in the index.",
      "columns": [
        {
          "field_id": "value",
          "label": "Column",
          "control": "reference",
          "required": true,
          "reference_kind": "column"
        }
      ]
    },
    {
      "field_id": "hash_sharded",
      "label": "Hash sharded",
      "tab": "Engine",
      "control": "boolean",
      "default": false,
      "editable_after_create": false,
      "help": "USING HASH: spreads sequential keys across ranges."
    },
    {
      "field_id": "bucket_count",
      "label": "Bucket count",
      "tab": "Engine",
      "control": "number",
      "min": 2,
      "max": 2048,
      "editable_after_create": false,
      "visible_when": {
        "field": "hash_sharded",
        "truthy": true
      },
      "help": "Default: the cluster setting."
    },
    {
      "field_id": "visibility",
      "label": "Visibility",
      "tab": "Engine",
      "control": "number",
      "min": 0,
      "max": 1,
      "default": 1,
      "help": "1 visible; 0 NOT VISIBLE; between, the share of queries that may use it. Changes in place."
    }
  ],
  "notes": "Hand-finished from providers/cockroachdb/indexes.py. The record takes keys from the index definition (expression keys read as crdb_internal_idx_expr in information_schema.statistics) and visibility from statistics; NOT VISIBLE reads back as 0. Round trip verified live on CockroachDB 26.1.3 by tools/tests/test_ui_descriptor_roundtrip_cockroachdb.py (2026-10-30)."
}
