      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "locality",
          "label": "Table locality",
          "control": "select",
          "required": true,
          "options": [
            {
              "value": "global",
              "label": "Global"
            },
            {
              "value": "regional_by_table",
              "label": "Regional by table"
