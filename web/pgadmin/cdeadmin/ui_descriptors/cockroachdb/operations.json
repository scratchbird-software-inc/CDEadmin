            {
              "value": "regional_by_row",
              "label": "Regional by row"
            }
          ]
        },
        {
          "field_id": "region",
          "label": "Table home region",
          "control": "text",
          "required": false,
          "visible_when": {
            "field": "locality",
            "equals": "regional_by_table"
          }
        },
        {
          "field_id": "region_column",
          "label": "Region column",
          "control": "text",
          "required": false,
          "visible_when": {
            "field": "locality",
            "equals": "regional_by_row"
