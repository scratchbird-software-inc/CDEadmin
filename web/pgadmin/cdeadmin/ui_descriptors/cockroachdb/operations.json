              "value": "skip",
              "label": "Skip"
            }
          ]
        },
        {
          "field_id": "wait",
          "label": "Wait for",
          "control": "select",
          "required": false,
          "default": "all",
          "options": [
            {
              "value": "all",
              "label": "All replicas relocated"
            },
            {
              "value": "none",
              "label": "Request acceptance only"
