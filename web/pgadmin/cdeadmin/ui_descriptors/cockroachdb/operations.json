      "tier": 3,
      "status": "draft",
      "confirmation": "typed_name",
      "fields": [
        {
          "field_id": "source_uri",
          "label": "Approved backup URI",
          "control": "text",
          "required": true
        },
        {
          "field_id": "database_name",
          "label": "Database name",
          "control": "text",
          "required": true
        },
        {
          "field_id": "new_database_name",
          "label": "Restore as database",
          "control": "text",
          "required": false
