      "required": false,
      "options": [
        {
          "value": "http",
          "label": "HTTP"
        },
        {
          "value": "https",
          "label": "HTTPS"
        }
      ],
      "default": "http"
    },
    {
      "field_id": "timeout",
      "label": "Socket timeout (seconds)",
      "tab": "Advanced",
      "control": "number",
      "backend_field_id": "cde_route_timeout",
      "group": "Ignite timeouts",
      "required": false,
      "default": 10,
      "min": 1,
      "max": 3600
    },
    {
      "field_id": "handshake_timeout",
      "label": "Handshake timeout (seconds)",
      "tab": "Advanced",
      "control": "number",
      "backend_field_id": "cde_route_handshake_timeout",
      "group": "Ignite timeouts",
      "required": false,
      "default": 10,
      "min": 1,
      "max": 3600
    },
    {
      "field_id": "rest_timeout",
      "label": "REST timeout (seconds)",
      "tab": "Advanced",
      "control": "number",
      "backend_field_id": "cde_route_rest_timeout",
      "group": "Ignite timeouts",
      "required": false,
      "default": 10,
      "min": 1,
      "max": 3600
    },
    {
      "field_id": "partition_aware",
      "label": "Partition-aware routing",
      "tab": "Engine",
      "control": "boolean",
      "backend_field_id": "cde_route_partition_aware",
      "group": "Ignite client",
      "required": false,
      "default": true
    },
    {
      "field_id": "compact_footer",
      "label": "Compact binary footer",
      "tab": "Engine",
      "control": "boolean",
      "backend_field_id": "cde_route_compact_footer",
      "group": "Ignite client",
      "required": false,
      "default": true
    },
    {
      "field_id": "transaction_concurrency",
      "label": "Transaction concurrency",
      "tab": "Engine",
      "control": "select",
      "backend_field_id": "cde_route_transaction_concurrency",
      "group": "Ignite transactions",
      "required": false,
      "options": [
        {
          "value": "optimistic",
          "label": "Optimistic"
        },
        {
          "value": "pessimistic",
          "label": "Pessimistic"
        }
      ],
      "default": "pessimistic"
    },
    {
      "field_id": "transaction_isolation",
      "label": "Transaction isolation",
      "tab": "Engine",
      "control": "select",
      "backend_field_id": "cde_route_transaction_isolation",
      "group": "Ignite transactions",
      "required": false,
      "options": [
        {
          "value": "read-committed",
          "label": "Read committed"
        },
        {
          "value": "repeatable-read",
          "label": "Repeatable read"
        },
        {
          "value": "serializable",
          "label": "Serializable"
        }
      ],
      "default": "repeatable-read"
    },
    {
      "field_id": "transaction_timeout",
      "label": "Transaction timeout (milliseconds)",
      "tab": "Engine",
      "control": "number",
      "backend_field_id": "cde_route_transaction_timeout",
      "group": "Ignite transactions",
      "required": false,
      "default": 0,
