      "required": false
    },
    {
      "field_id": "control_host",
      "label": "Control-plane host",
      "tab": "Engine",
      "control": "text",
      "backend_field_id": "cde_route_control_host",
      "group": "Ignite control plane",
      "required": false
    },
    {
      "field_id": "control_port",
      "label": "Control-plane client port",
      "tab": "Engine",
      "control": "number",
      "backend_field_id": "cde_route_control_port",
      "group": "Ignite control plane",
      "required": false,
