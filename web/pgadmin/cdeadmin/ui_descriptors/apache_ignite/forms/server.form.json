{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "apache_ignite",
  "family": "server",
  "resource_kinds": [
    "server"
  ],
  "status": "draft",
  "engine_tab_title": "Apache Ignite",
  "omitted_tabs": [],
  "gaps": [],
  "fields": [
    {
      "field_id": "name",
      "label": "Connection profile name",
      "tab": "Connection",
      "control": "text",
      "backend_field_id": "name",
      "required": true
    },
    {
      "field_id": "host",
      "label": "Server host or address",
      "tab": "Connection",
      "control": "text",
      "backend_field_id": "host",
      "required": true
    },
    {
      "field_id": "port",
      "label": "Server port",
      "tab": "Connection",
      "control": "number",
      "backend_field_id": "port",
      "required": true,
      "min": 1,
      "max": 65535
    },
    {
      "field_id": "database",
      "tab": "Connection",
      "backend_field_id": "db",
      "label": "Maintenance database",
      "control": "text",
      "required": true,
      "help": "Database the profile connects to first; leave empty for the engine default."
    },
    {
      "field_id": "connect_now",
      "label": "Connect now",
      "tab": "Connection",
      "control": "boolean",
      "default": true,
      "backend_field_id": "connect_now"
    },
    {
      "field_id": "comment",
      "label": "Comments",
      "tab": "Connection",
      "control": "code",
      "language": "text",
      "backend_field_id": "comment"
    },
    {
      "field_id": "username",
      "label": "Username",
      "tab": "Authentication",
      "control": "text",
      "backend_field_id": "cde_route_username",
      "required": false,
      "visible_when": {
        "field": "auth_mode",
        "equals": "username-password"
      }
    },
    {
      "field_id": "auth_mode",
      "label": "Authentication",
      "tab": "Authentication",
      "control": "select",
      "backend_field_id": "cde_route_auth_mode",
      "group": "Ignite authentication",
      "required": false,
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "username-password",
          "label": "Username and password"
        }
      ],
      "default": "none"
    },
    {
      "field_id": "password",
      "label": "Password",
      "tab": "Authentication",
      "control": "password",
      "backend_field_id": "cde_secret_password",
      "required": false,
      "visible_when": {
        "field": "auth_mode",
        "equals": "username-password"
      }
    },
    {
      "field_id": "save_password",
      "label": "Save default connection credentials",
      "tab": "Authentication",
      "control": "boolean",
      "backend_field_id": "save_password",
      "required": false,
      "default": false,
      "help": "Store the credentials for the default user in ScratchRobin. Credentials entered while connecting as another user are never stored as the default credentials."
    },
    {
      "field_id": "tls_mode",
      "label": "TLS mode",
      "tab": "SSL/TLS",
      "control": "select",
      "backend_field_id": "cde_route_tls_mode",
      "group": "Ignite TLS",
      "required": false,
      "options": [
        {
          "value": "disabled",
          "label": "Disabled"
        },
        {
          "value": "required",
          "label": "Encrypted without verification"
        },
        {
          "value": "verify-ca",
          "label": "Verify certificate authority"
        }
      ],
      "default": "disabled"
    },
    {
      "field_id": "tls_ca_file",
      "label": "Certificate authority file",
      "tab": "SSL/TLS",
      "control": "file",
      "backend_field_id": "cde_route_tls_ca_file",
      "group": "Ignite TLS",
      "required": false
    },
    {
      "field_id": "tls_certificate_file",
      "label": "Client certificate",
      "tab": "SSL/TLS",
      "control": "file",
      "backend_field_id": "cde_route_tls_certificate_file",
      "group": "Ignite TLS",
      "required": false
    },
    {
      "field_id": "tls_key_file",
      "label": "Client private key",
      "tab": "SSL/TLS",
      "control": "file",
      "backend_field_id": "cde_route_tls_key_file",
      "group": "Ignite TLS",
      "required": false
    },
    {
      "field_id": "tls_key_password",
      "label": "Client private-key password",
      "tab": "SSL/TLS",
      "control": "password",
      "backend_field_id": "cde_secret_tls_key_password",
      "group": "Ignite TLS",
      "required": false
    },
    {
      "field_id": "contact_points",
