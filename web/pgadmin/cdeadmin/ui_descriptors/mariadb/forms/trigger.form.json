{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "mariadb",
  "family": "trigger",
  "resource_kinds": [
    "trigger"
  ],
  "form_reference": "SR-F-020050",
  "status": "complete",
  "engine_tab_title": "MariaDB",
  "omitted_tabs": [],
  "gaps": [],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true,
      "editable_after_create": false
    },
    {
      "field_id": "parent",
      "label": "Database",
      "tab": "General",
      "control": "reference",
      "required": false,
      "editable_after_create": false,
      "help": "Use a qualified database name where needed.",
      "reference_kind": "database"
    },
    {
      "field_id": "table",
      "label": "Table",
      "tab": "General",
      "control": "reference",
      "required": true,
      "editable_after_create": false,
      "reference_kind": "table",
      "record_key": "navigator_parent_resource_id",
      "record_pattern": "^[a-z-]+:(?:[^:]+:)?(.*)$"
    },
    {
      "field_id": "timing",
      "label": "Timing",
      "tab": "General",
      "control": "select",
      "required": true,
      "initial_value_path": [
        "timing"
      ],
      "options": [
        {
          "value": "BEFORE",
          "label": "BEFORE"
        },
        {
          "value": "AFTER",
          "label": "AFTER"
        }
      ]
    },
    {
      "field_id": "events",
      "label": "Events",
      "tab": "General",
      "control": "multiselect",
      "required": true,
      "default": [
        "INSERT"
      ],
      "initial_value_path": [
        "events"
      ],
      "option_values_path": [
        "dialect",
        "trigger_events",
        "table"
      ]
    },
    {
      "field_id": "body",
      "label": "Trigger body",
      "tab": "Definition",
      "control": "code",
      "language": "sql",
      "required": true,
      "initial_value_path": [
        "body"
      ],
      "help": "Enter only the trigger body, not CREATE OR REPLACE TRIGGER."
    },
    {
      "field_id": "order_kind",
      "label": "Sibling trigger order",
      "tab": "Options",
      "control": "select",
      "required": false,
      "default": "NONE",
      "options": [
        {
          "value": "NONE",
          "label": "Preserve / default"
        },
        {
          "value": "FOLLOWS",
          "label": "FOLLOWS"
        },
        {
          "value": "PRECEDES",
          "label": "PRECEDES"
        }
      ]
    },
    {
      "field_id": "order_trigger",
      "label": "Sibling trigger name",
      "tab": "Options",
      "control": "text",
      "required": false,
      "visible_when": {
        "field": "order_kind",
        "in": [
          "FOLLOWS",
          "PRECEDES"
        ]
      }
    },
    {
      "field_id": "sql_mode",
      "label": "Compilation SQL mode",
      "tab": "Engine",
      "control": "text",
      "required": false,
      "initial_value_path": [
        "sql_mode"
      ]
    },
    {
      "field_id": "definer_mode",
      "label": "Definer assignment",
      "tab": "Engine",
      "control": "select",
      "required": false,
      "default": "OMIT",
      "options": [
        {
          "value": "OMIT",
          "label": "Default (current session user)"
        },
        {
          "value": "CURRENT_USER",
          "label": "Explicit CURRENT_USER"
        },
        {
          "value": "ACCOUNT",
          "label": "Named user@host account"
        }
      ]
    },
    {
      "field_id": "definer_user",
      "label": "Definer user",
      "tab": "Engine",
      "control": "text",
      "required": false,
      "visible_when": {
        "field": "definer_mode",
        "equals": "ACCOUNT"
      }
    },
    {
      "field_id": "definer_host",
      "label": "Definer host",
      "tab": "Engine",
      "control": "text",
      "required": false,
      "visible_when": {
        "field": "definer_mode",
        "equals": "ACCOUNT"
      }
    }
  ],
  "notes": "MariaDB 12.2.2 trigger create and CREATE OR REPLACE editor preserving FOLLOWS/PRECEDES sibling ordering, multi-event triggers (INSERT OR UPDATE OR DELETE), DEFINER and sql_mode."
}
