{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "mariadb",
  "family": "index",
  "resource_kinds": [
    "index"
  ],
  "form_reference": "SR-F-020044",
  "status": "complete",
  "engine_tab_title": "MariaDB",
  "omitted_tabs": [],
  "gaps": [],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true,
      "modes": [
        "create"
      ]
    },
    {
      "field_id": "new_name",
      "label": "New index name",
      "tab": "General",
      "control": "text",
      "required": false,
      "modes": [
        "alter"
      ],
      "help": "Emits ALTER TABLE ... RENAME INDEX when changed."
    },
    {
      "field_id": "parent",
      "label": "Database",
      "tab": "General",
      "control": "reference",
      "required": false,
      "modes": [
        "create"
      ],
      "help": "Use a qualified database name where needed.",
      "reference_kind": "database"
    },
    {
      "field_id": "table",
      "label": "Table",
      "tab": "General",
      "control": "reference",
      "required": true,
      "editable_after_create": false,
      "reference_kind": "table",
      "record_key": "navigator_parent_resource_id",
      "record_pattern": "^[a-z-]+:(?:[^:]+:)?(.*)$"
    },
    {
      "field_id": "index_kind",
      "label": "Index kind",
      "tab": "General",
      "control": "select",
      "required": false,
      "default": "NORMAL",
      "editable_after_create": false,
      "initial_value_path": [
        "index_kind"
      ],
      "options": [
        {
          "value": "NORMAL",
          "label": "Secondary / normal"
        },
        {
          "value": "FULLTEXT",
          "label": "FULLTEXT"
        },
        {
          "value": "SPATIAL",
          "label": "SPATIAL"
        },
        {
          "value": "VECTOR",
          "label": "VECTOR (MHNSW)",
          "version": {
            "minimum": "11.7.1"
          }
        }
      ]
    },
    {
      "field_id": "unique",
      "label": "Unique index",
      "tab": "General",
      "control": "boolean",
      "required": false,
      "default": false,
      "editable_after_create": false,
      "initial_value_path": [
        "unique"
      ],
      "visible_when": {
        "field": "index_kind",
        "equals": "NORMAL"
      }
    },
    {
      "field_id": "columns",
      "label": "Indexed key parts",
      "tab": "General",
      "control": "grid",
      "required": true,
      "editable_after_create": false,
      "record_key": "definition_parts",
      "initial_value_path": [
        "definition_parts"
      ],
      "columns": [
        {
          "field_id": "name",
          "label": "Column",
          "control": "reference",
          "required": true,
          "reference_kind": "column",
          "reference_value": "display_name"
        },
        {
          "field_id": "prefix_length",
          "label": "Prefix length",
          "control": "number",
          "required": false,
          "min": 1,
          "max": 65535
        },
        {
          "field_id": "direction",
          "label": "Direction",
          "control": "select",
          "required": false,
          "default": "DEFAULT",
          "options": [
            {
              "value": "DEFAULT",
              "label": "Default"
            },
            {
              "value": "ASC",
              "label": "Ascending"
            },
            {
              "value": "DESC",
              "label": "Descending"
            }
          ]
        }
      ]
    },
    {
      "field_id": "comment",
      "label": "Comment",
      "tab": "General",
      "control": "text",
      "required": false,
      "editable_after_create": false,
      "record_key": "index_comment",
      "initial_value_path": [
        "index_comment"
      ]
    },
    {
      "field_id": "method",
      "label": "Index structure (USING)",
      "tab": "Options",
      "control": "select",
      "required": false,
      "default": "DEFAULT",
      "editable_after_create": false,
      "initial_value_path": [
        "method"
      ],
      "options": [
        {
          "value": "DEFAULT",
          "label": "Engine default"
        },
        {
          "value": "BTREE",
          "label": "BTREE"
        },
        {
          "value": "HASH",
          "label": "HASH"
        },
        {
          "value": "RTREE",
          "label": "RTREE (SPATIAL)"
        }
      ]
    },
    {
      "field_id": "ignored",
      "label": "Ignored by optimizer (IGNORED)",
      "tab": "Options",
      "control": "boolean",
      "required": false,
      "default": false,
      "native_keyword": "IGNORED",
      "initial_value_path": [
        "ignored"
      ],
      "help": "Marks the index IGNORED or NOT IGNORED for the query optimizer."
    },
    {
      "field_id": "key_block_size",
      "label": "Key block size",
      "tab": "Options",
      "control": "text",
      "required": false,
      "editable_after_create": false,
      "native_keyword": "KEY_BLOCK_SIZE",
      "help": "Unsigned decimal byte/kilobyte hint."
    },
    {
      "field_id": "parser",
      "label": "Full-text parser plugin",
      "tab": "Engine",
      "group": "FULLTEXT",
      "control": "text",
      "required": false,
      "editable_after_create": false,
      "native_keyword": "WITH PARSER",
      "initial_value_path": [
        "parser"
      ],
      "visible_when": {
        "field": "index_kind",
        "equals": "FULLTEXT"
      }
    },
    {
      "field_id": "vector_m",
      "label": "MHNSW neighbor count (M)",
      "tab": "Engine",
      "group": "VECTOR",
      "control": "number",
      "required": false,
      "min": 3,
      "max": 200,
      "editable_after_create": false,
      "native_keyword": "M",
      "initial_value_path": [
        "vector_m"
      ],
      "visible_when": {
        "field": "index_kind",
        "equals": "VECTOR"
      }
    },
    {
      "field_id": "vector_distance",
      "label": "Vector distance metric",
      "tab": "Engine",
      "group": "VECTOR",
      "control": "select",
      "required": false,
      "editable_after_create": false,
      "native_keyword": "DISTANCE",
      "initial_value_path": [
        "vector_distance"
      ],
      "options": [
        {
          "value": "euclidean",
          "label": "Euclidean"
        },
        {
          "value": "cosine",
          "label": "Cosine"
        }
      ],
      "visible_when": {
        "field": "index_kind",
        "equals": "VECTOR"
      }
    },
    {
      "field_id": "algorithm",
      "label": "DDL algorithm",
      "tab": "Engine",
      "group": "Online DDL",
      "control": "select",
      "required": false,
      "default": "DEFAULT",
      "modes": [
        "create"
      ],
      "options": [
        {
          "value": "DEFAULT",
          "label": "DEFAULT"
        },
        {
          "value": "INPLACE",
          "label": "INPLACE"
        },
        {
          "value": "COPY",
          "label": "COPY"
        },
        {
          "value": "NOCOPY",
          "label": "NOCOPY"
        },
        {
          "value": "INSTANT",
          "label": "INSTANT"
        }
      ]
    },
    {
      "field_id": "lock",
      "label": "DDL lock level",
      "tab": "Engine",
      "group": "Online DDL",
      "control": "select",
      "required": false,
      "default": "DEFAULT",
      "modes": [
        "create"
      ],
      "options": [
        {
          "value": "DEFAULT",
          "label": "DEFAULT"
        },
        {
          "value": "NONE",
          "label": "NONE"
        },
        {
          "value": "SHARED",
          "label": "SHARED"
        },
        {
          "value": "EXCLUSIVE",
          "label": "EXCLUSIVE"
        }
      ]
    }
  ],
  "notes": "MariaDB 12.2.2 native index creation and alteration: NORMAL/UNIQUE, FULLTEXT (WITH PARSER), SPATIAL (RTREE), and VECTOR (M=3..200, DISTANCE=cosine|euclidean), plus IGNORED/NOT IGNORED visibility and RENAME INDEX."
}
