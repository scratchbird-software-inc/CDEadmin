{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "mariadb",
  "family": "view",
  "resource_kinds": [
    "view"
  ],
  "form_reference": "SR-F-020051",
  "status": "complete",
  "engine_tab_title": "MariaDB",
  "omitted_tabs": [
    {
      "tab": "Triggers",
      "reason": "MariaDB does not allow triggers on views."
    }
  ],
  "gaps": [],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true,
      "editable_after_create": false
    },
    {
      "field_id": "parent",
      "label": "Database",
      "tab": "General",
      "control": "reference",
      "required": false,
      "editable_after_create": false,
      "help": "Use a qualified database name where needed.",
      "reference_kind": "database"
    },
    {
      "field_id": "query",
      "label": "View query",
      "tab": "Definition",
      "control": "code",
      "language": "sql",
      "required": true,
      "help": "One SELECT or WITH query; do not include the CREATE or ALTER VIEW prefix.",
      "initial_value_path": [
        "view_definition"
      ],
      "record_key": "ddl",
      "record_pattern": "\\bVIEW\\s+`[^`]+`\\s+AS\\s+(.*)$"
    },
    {
      "field_id": "columns",
      "label": "Explicit column aliases",
      "tab": "Columns",
      "control": "grid",
      "required": false,
      "initial_value_path": [
        "view_aliases"
      ],
      "columns": [
        {
          "field_id": "name",
          "label": "Column alias",
          "control": "text",
          "required": true
        }
      ]
    },
    {
      "field_id": "algorithm",
      "label": "Evaluation algorithm",
      "tab": "Options",
      "control": "select",
      "required": false,
      "default": "UNDEFINED",
      "native_keyword": "ALGORITHM",
      "initial_value_path": [
        "algorithm"
      ],
      "options": [
        {
          "value": "UNDEFINED",
          "label": "UNDEFINED"
        },
        {
          "value": "MERGE",
          "label": "MERGE"
        },
        {
          "value": "TEMPTABLE",
          "label": "TEMPTABLE"
        }
      ]
    },
    {
      "field_id": "sql_security",
      "label": "SQL security context",
      "tab": "Options",
      "control": "select",
      "required": false,
      "default": "DEFINER",
      "native_keyword": "SQL SECURITY",
      "initial_value_path": [
        "sql_security"
      ],
      "options": [
        {
          "value": "DEFINER",
          "label": "DEFINER"
        },
        {
          "value": "INVOKER",
          "label": "INVOKER"
        }
      ]
    },
    {
      "field_id": "check_option",
      "label": "Updatable view check option",
      "tab": "Options",
      "control": "select",
      "required": false,
      "default": "NONE",
      "native_keyword": "WITH CHECK OPTION",
      "initial_value_path": [
        "check_option"
      ],
      "options": [
        {
          "value": "NONE",
          "label": "None"
        },
        {
          "value": "CASCADED",
          "label": "CASCADED"
        },
        {
          "value": "LOCAL",
          "label": "LOCAL"
        }
      ]
    },
    {
      "field_id": "definer_mode",
      "label": "Definer assignment",
      "tab": "Engine",
      "control": "select",
      "required": false,
      "default": "OMIT",
      "options": [
        {
          "value": "OMIT",
          "label": "Default (current session user)"
        },
        {
          "value": "CURRENT_USER",
          "label": "Explicit CURRENT_USER"
        },
        {
          "value": "ACCOUNT",
          "label": "Named user@host account"
        }
      ]
    },
    {
      "field_id": "definer_user",
      "label": "Definer user",
      "tab": "Engine",
      "control": "text",
      "required": false,
      "initial_value_path": [
        "definer_user"
      ],
      "visible_when": {
        "field": "definer_mode",
        "equals": "ACCOUNT"
      }
    },
    {
      "field_id": "definer_host",
      "label": "Definer host",
      "tab": "Engine",
      "control": "text",
      "required": false,
      "initial_value_path": [
        "definer_host"
      ],
      "visible_when": {
        "field": "definer_mode",
        "equals": "ACCOUNT"
      }
    }
  ],
  "notes": "MariaDB 12.2.2 view create and alter editor supporting ALGORITHM, DEFINER, SQL SECURITY, explicit column aliases and WITH CASCADED/LOCAL CHECK OPTION."
}
