{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "mariadb",
  "family": "sequence",
  "resource_kinds": [
    "sequence"
  ],
  "form_reference": "SR-F-020047",
  "status": "complete",
  "engine_tab_title": "MariaDB",
  "omitted_tabs": [],
  "gaps": [],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true,
      "editable_after_create": false
    },
    {
      "field_id": "parent",
      "label": "Database",
      "tab": "General",
      "control": "reference",
      "reference_kind": "database",
      "reference_value": "display_name",
      "editable_after_create": false
    },
    {
      "field_id": "or_replace",
      "label": "Replace existing sequence (OR REPLACE)",
      "tab": "General",
      "control": "boolean",
      "default": false,
      "modes": [
        "create"
      ],
      "native_keyword": "OR REPLACE"
    },
    {
      "field_id": "if_not_exists",
      "label": "Skip if exists (IF NOT EXISTS)",
      "tab": "General",
      "control": "boolean",
      "default": false,
      "modes": [
        "create"
      ],
      "native_keyword": "IF NOT EXISTS"
    },
    {
      "field_id": "temporary",
      "label": "Temporary (session-scoped)",
      "tab": "General",
      "control": "boolean",
      "default": false,
      "modes": [
        "create"
      ],
      "native_keyword": "TEMPORARY"
    },
    {
      "field_id": "current_value",
      "label": "Current position (next_not_cached_value)",
      "tab": "General",
      "control": "text",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "record_key": "current_value",
      "help": "Observed directly from the sequence table without calling NEXTVAL."
    },
    {
      "field_id": "integer_type",
      "label": "Native integer type",
      "control": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Preserve / Default (BIGINT)"
        },
        {
          "value": "TINYINT",
          "label": "TINYINT"
        },
        {
          "value": "SMALLINT",
          "label": "SMALLINT"
        },
        {
          "value": "MEDIUMINT",
          "label": "MEDIUMINT"
        },
        {
          "value": "INT",
          "label": "INT"
        },
        {
          "value": "BIGINT",
          "label": "BIGINT"
        }
      ],
      "tab": "General",
      "help": "Native ALTER AS cannot be combined with other sequence options. Review type changes separately; no automatic multi-statement split."
    },
    {
      "field_id": "unsigned",
      "label": "Unsigned (requires explicit type)",
      "control": "boolean",
      "default": false,
      "tab": "General"
    },
    {
      "field_id": "start",
      "label": "Exact start value",
      "control": "text",
      "tab": "General",
      "record_key": "ddl",
      "record_pattern": "\\bstart with (-?\\d+)"
    },
    {
      "field_id": "increment",
      "label": "Exact signed increment",
      "control": "text",
      "tab": "General",
      "record_key": "ddl",
      "record_pattern": "\\bincrement by (-?\\d+)"
    },
    {
      "field_id": "cache",
      "label": "Exact signed cache size (0 = NOCACHE)",
      "control": "text",
      "tab": "General",
      "record_key": "ddl",
      "record_pattern": "\\bcache (-?\\d+)"
    },
    {
      "field_id": "minimum_mode",
      "label": "Minimum intent",
      "control": "select",
      "default": "PRESERVE",
      "options": [
        {
          "value": "PRESERVE",
          "label": "PRESERVE"
        },
        {
          "value": "VALUE",
          "label": "VALUE"
        },
        {
          "value": "NATIVE",
          "label": "NATIVE (NO MINVALUE)"
        }
      ],
      "tab": "General",
      "record_derive": {
        "cases": [
          {
            "key": "ddl",
            "matches": "\\bnominvalue\\b|\\bno minvalue\\b",
            "value": "NATIVE"
          },
          {
            "key": "ddl",
            "matches": "\\bminvalue\\s+-?\\d+",
            "value": "VALUE"
          }
        ],
        "default": "PRESERVE"
      }
    },
    {
      "field_id": "minimum",
      "label": "Exact minimum",
      "control": "text",
      "visible_when": {
        "equals": "VALUE",
        "field": "minimum_mode"
      },
      "tab": "General",
      "record_key": "ddl",
      "record_pattern": "\\bminvalue (-?\\d+)"
    },
    {
      "field_id": "maximum_mode",
      "label": "Maximum intent",
      "control": "select",
      "default": "PRESERVE",
      "options": [
        {
          "value": "PRESERVE",
          "label": "PRESERVE"
        },
        {
          "value": "VALUE",
          "label": "VALUE"
        },
        {
          "value": "NATIVE",
          "label": "NATIVE (NO MAXVALUE)"
        }
      ],
      "tab": "General",
      "record_derive": {
        "cases": [
          {
            "key": "ddl",
            "matches": "\\bnomaxvalue\\b|\\bno maxvalue\\b",
            "value": "NATIVE"
          },
          {
            "key": "ddl",
            "matches": "\\bmaxvalue\\s+-?\\d+",
            "value": "VALUE"
          }
        ],
        "default": "PRESERVE"
      }
    },
    {
      "field_id": "maximum",
      "label": "Exact maximum",
      "control": "text",
      "visible_when": {
        "equals": "VALUE",
        "field": "maximum_mode"
      },
      "tab": "General",
      "record_key": "ddl",
      "record_pattern": "\\bmaxvalue (-?\\d+)"
    },
    {
      "field_id": "cycle_mode",
      "label": "Cycle intent",
      "control": "select",
      "default": "PRESERVE",
      "options": [
        {
          "value": "PRESERVE",
          "label": "PRESERVE"
        },
        {
          "value": "CYCLE",
          "label": "CYCLE"
        },
        {
          "value": "NOCYCLE",
          "label": "NOCYCLE"
        }
      ],
      "tab": "General",
      "record_derive": {
        "cases": [
          {
            "key": "ddl",
            "matches": "\\bnocycle\\b",
            "value": "NOCYCLE"
          },
          {
            "key": "ddl",
            "matches": "\\bcycle\\b",
            "value": "CYCLE"
          }
        ],
        "default": "PRESERVE"
      }
    },
    {
      "field_id": "comment",
      "label": "Comment",
      "tab": "General",
      "control": "text",
      "record_key": "comment",
      "native_keyword": "COMMENT"
    },
    {
      "field_id": "restart",
      "label": "Exact next value",
      "control": "text",
      "modes": [
        "alter"
      ],
      "tab": "General"
    },
    {
      "field_id": "restart_initial",
      "label": "Restart at original start",
      "control": "boolean",
      "default": false,
      "modes": [
        "alter"
      ],
      "tab": "General"
    },
    {
      "field_id": "confirmation",
      "label": "Sequence name (restart only)",
      "control": "text",
      "modes": [
        "alter"
      ],
      "tab": "General"
    }
  ],
  "notes": "Native typed options preserve exact decimal values; native bounds/default intent, sequence comments, and confirmed restart are explicit."
}
