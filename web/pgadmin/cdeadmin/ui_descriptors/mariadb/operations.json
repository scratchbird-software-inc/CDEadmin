    {
      "operation_id": "backup_logical",
      "resource_kind": "database",
      "title": "Back up database",
      "menu": {
        "category": "backup_restore"
      },
      "tier": 3,
      "status": "draft",
      "confirmation": "none",
      "fields": [
        {
          "field_id": "path",
          "label": "New SQL dump file below the endpoint tool workspace",
          "control": "text",
          "required": true
        },
        {
          "field_id": "include_schema",
          "label": "Include database and object definitions",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "include_data",
          "label": "Include table data",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "single_transaction",
          "label": "Use one consistent transaction for transactional tables",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "lock_all_tables",
          "label": "Hold a global read lock for the entire dump",
          "control": "boolean",
          "required": false,
          "default": false
        },
        {
          "field_id": "add_drop_database",
          "label": "Include DROP DATABASE before CREATE DATABASE",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "add_drop_table",
          "label": "Include DROP TABLE before each table",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "routines",
          "label": "Include stored functions and procedures",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "events",
          "label": "Include events",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "triggers",
          "label": "Include triggers",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "dump_history",
          "label": "Include system-versioned table history",
          "control": "boolean",
          "required": false,
          "default": false
        },
        {
          "field_id": "as_of",
          "label": "Dump system-versioned rows as of this timestamp",
          "control": "text",
          "required": false
        },
        {
          "field_id": "hex_blob",
          "label": "Write binary values in hexadecimal",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "order_by_primary",
          "label": "Write rows in primary-key order",
          "control": "boolean",
          "required": false,
          "default": false
        },
        {
          "field_id": "extended_insert",
          "label": "Use multi-row INSERT statements",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "complete_insert",
          "label": "Include column names in INSERT statements",
          "control": "boolean",
          "required": false,
          "default": false
        },
        {
          "field_id": "comments",
          "label": "Include dump comments",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "dump_date",
          "label": "Include completion date",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "default_character_set",
          "label": "Dump connection character set",
          "control": "text",
          "required": false,
          "default": "utf8mb4"
        },
        {
          "field_id": "tz_utc",
          "label": "Normalize timestamp columns to UTC",
          "control": "boolean",
          "required": false,
          "default": true
        },
        {
          "field_id": "flush_logs",
          "label": "Flush server logs before the dump",
          "control": "boolean",
          "required": false,
          "default": false
        },
        {
          "field_id": "replication_position",
          "label": "Replication coordinates",
          "control": "select",
          "required": false,
          "default": "NONE",
          "options": [
            {
              "value": "NONE",
              "label": "Do not emit CHANGE MASTER"
            },
            {
              "value": "COMMENTED",
              "label": "Emit commented coordinates"
            },
            {
              "value": "EXECUTABLE",
              "label": "Emit executable coordinates"
            }
          ]
        },
        {
          "field_id": "gtid",
          "label": "Use GTID coordinates with replication position",
          "control": "boolean",
          "required": false,
          "default": false
        },
        {
          "field_id": "compress_connection",
          "label": "Compress the client/server connection",
          "control": "boolean",
          "required": false,
          "default": false
        },
        {
          "field_id": "max_allowed_packet",
          "label": "Maximum packet bytes",
          "control": "number",
          "required": false,
          "default": 1073741824
        }
      ],
      "execution_host": true,
      "produces_log": true
    },
