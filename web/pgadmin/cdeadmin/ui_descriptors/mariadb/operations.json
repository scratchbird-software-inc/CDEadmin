      "resource_kind": "database",
      "title": "Analyze tables and persistent statistics",
      "menu": {
        "category": "diagnostics"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "none",
      "fields": [
        {
          "field_id": "tables",
          "label": "Native table names (JSON array)",
          "control": "keyvalue",
          "required": true
        },
        {
          "field_id": "binlog_mode",
          "label": "Binary-log mode",
          "control": "select",
          "required": false,
          "default": "DEFAULT",
          "options": [
            {
              "value": "DEFAULT",
              "label": "Server default"
            },
            {
              "value": "NO_WRITE_TO_BINLOG",
              "label": "Do not write to binary log"
            },
            {
              "value": "LOCAL",
              "label": "Local only"
            }
          ]
        },
        {
          "field_id": "persistent_for",
          "label": "Persistent statistics",
          "control": "select",
          "required": false,
          "default": "NONE",
          "options": [
            {
              "value": "NONE",
              "label": "Do not collect persistent statistics"
            },
            {
              "value": "ALL",
              "label": "All columns and indexes"
            },
            {
              "value": "SPECIFIED",
              "label": "Specified columns and indexes"
            }
          ]
        },
        {
          "field_id": "persistent_columns",
          "label": "Persistent-statistics columns (JSON array, empty means none)",
          "control": "keyvalue",
          "required": false
        },
        {
          "field_id": "persistent_indexes",
          "label": "Persistent-statistics indexes (JSON array, empty means none)",
          "control": "keyvalue",
          "required": false
        }
      ],
      "notes": "typed_from_json: database.analyze_tables.tables, database.analyze_tables.persistent_columns, database.analyze_tables.persistent_indexes"
    },
