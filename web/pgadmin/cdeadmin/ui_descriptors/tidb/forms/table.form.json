{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "tidb",
  "family": "table",
  "resource_kinds": [
    "table"
  ],
  "form_reference": "SR-F-020084",
  "status": "complete",
  "engine_tab_title": "TiDB",
  "omitted_tabs": [],
  "gaps": [],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true
    },
    {
      "field_id": "parent",
      "label": "Database",
      "tab": "General",
      "control": "reference",
      "required": false,
      "help": "Use a qualified database or schema name where needed.",
      "reference_kind": "database"
    },
    {
      "field_id": "shard_row_id_bits",
      "label": "Shard row ID bits",
      "tab": "General",
      "control": "number",
      "required": false,
      "editable_after_create": false,
      "native_keyword": "SHARD_ROW_ID_BITS",
      "help": "1 to 15. Scatters the hidden row ID of a table without an integer primary key. Change it later with Table options."
    },
    {
      "field_id": "pre_split_regions",
      "label": "Pre-split regions (bits)",
      "tab": "General",
      "control": "number",
      "required": false,
      "editable_after_create": false,
      "native_keyword": "PRE_SPLIT_REGIONS",
      "help": "Split into 2^n regions at create. Needs shard row ID bits or an AUTO_RANDOM key, and at most their bits; TiDB would drop or cut it otherwise."
    },
    {
      "field_id": "columns",
      "label": "Columns",
      "tab": "Columns",
      "control": "grid",
      "columns": [
        {
          "field_id": "name",
          "label": "Column name",
          "control": "text",
          "required": true
        },
        {
          "field_id": "type",
          "label": "Native data type",
          "control": "text",
          "required": true,
          "record_key": "data_type"
        },
        {
          "field_id": "nullable",
          "label": "Nullable",
          "control": "boolean",
          "required": false,
          "default": true,
          "record_derive": {
            "cases": [
              {
                "key": "is_nullable",
                "equals": "YES",
                "value": true
              }
            ],
            "default": false
          }
        },
        {
          "field_id": "default",
          "label": "Default expression",
          "control": "text",
          "required": false,
          "record_key": "default_expression"
        },
        {
          "field_id": "unique",
          "label": "Unique",
          "control": "boolean",
          "required": false,
          "default": false,
          "record_derive": {
            "cases": [
              {
                "key": "column_key",
                "equals": "UNI",
                "value": true
              }
            ],
            "default": false
          }
        },
        {
          "field_id": "primary_key",
          "label": "Primary key",
          "control": "boolean",
          "required": false,
          "default": false,
          "record_derive": {
            "cases": [
              {
                "key": "column_key",
                "equals": "PRI",
                "value": true
              }
            ],
            "default": false
          }
        },
        {
          "field_id": "auto_random",
          "label": "AUTO_RANDOM shard bits",
          "control": "number",
          "required": false,
          "editable_after_create": false,
          "native_keyword": "AUTO_RANDOM",
          "help": "1 to 15. A clustered BIGINT primary key only; TiDB fills it with random-prefixed values. Fixed at creation here."
        },
        {
          "field_id": "auto_random_range",
          "label": "AUTO_RANDOM range bits",
          "control": "number",
          "required": false,
          "editable_after_create": false,
          "help": "32 to 64; empty for TiDB's default (64). Needs the shard bits."
        }
      ],
      "required": true,
      "help": "Array of name, type, nullable, default, unique and primary_key properties, with auto_random and auto_random_range for a TiDB AUTO_RANDOM key."
    },
    {
      "field_id": "primary_key",
      "label": "Primary key",
      "control": "grid",
      "tab": "Constraints",
      "group": "Primary key",
      "backend_field_id": "constraints[kind=PRIMARY KEY]",
      "columns": [
        {
          "field_id": "name",
          "label": "Name",
          "control": "text"
        },
        {
          "field_id": "columns",
          "label": "Columns",
          "control": "multiselect",
          "required": true,
          "option_values_path": [
            "draft",
            "columns"
          ]
        }
      ],
      "record_filter": {
        "key": "constraint_type",
        "equals": "PRIMARY KEY"
      }
    },
    {
      "field_id": "unique_constraints",
      "label": "Unique",
      "control": "grid",
      "tab": "Constraints",
      "group": "Unique",
      "backend_field_id": "constraints[kind=UNIQUE]",
      "columns": [
        {
          "field_id": "name",
          "label": "Name",
          "control": "text"
        },
        {
          "field_id": "columns",
          "label": "Columns",
          "control": "multiselect",
          "required": true,
          "option_values_path": [
            "draft",
            "columns"
          ]
        }
      ],
      "record_filter": {
        "key": "constraint_type",
        "equals": "UNIQUE"
      }
    },
    {
      "field_id": "foreign_keys",
      "label": "Foreign keys",
      "control": "grid",
      "tab": "Constraints",
      "group": "Foreign keys",
      "backend_field_id": "constraints[kind=FOREIGN KEY]",
      "columns": [
        {
          "field_id": "name",
          "label": "Name",
          "control": "text"
        },
        {
          "field_id": "columns",
          "label": "Columns",
          "control": "multiselect",
          "required": true,
          "option_values_path": [
            "draft",
            "columns"
          ]
        },
        {
          "field_id": "references_table",
          "label": "Referenced table",
          "control": "reference",
          "required": true,
          "reference_kind": "table",
          "record_key": "referenced_table"
        },
        {
          "field_id": "references_columns",
          "label": "Referenced columns",
          "control": "multiselect",
          "required": true,
          "help": "Columns of the referenced table, in key order.",
          "record_key": "referenced_columns"
        }
      ],
      "record_filter": {
        "key": "constraint_type",
        "equals": "FOREIGN KEY"
      }
    },
    {
      "field_id": "check_constraints",
      "label": "Check",
      "control": "grid",
      "tab": "Constraints",
      "group": "Check",
      "backend_field_id": "constraints[kind=CHECK]",
      "columns": [
        {
          "field_id": "name",
          "label": "Name",
          "control": "text"
        },
        {
          "field_id": "expression",
          "label": "Expression",
          "control": "code",
          "required": true,
          "language": "sql",
          "record_key": "check_clause",
          "record_pattern": "^\\((.*)\\)$"
        }
      ],
      "record_filter": {
        "key": "constraint_type",
        "equals": "CHECK"
      },
      "help": "TiDB keeps CHECK constraints only while the global tidb_enable_check_constraint is ON; otherwise applying is refused rather than the constraint silently dropped."
    }
  ],
  "notes": "Drafted by tools/draft_ui_descriptors.py from the provider's effective create/alter forms; field ids, options and visibility are the provider's own. Review tab placement, finish typing any keyvalue field listed under gaps, split combined constraint grids, then set status complete after a verified round trip. Alter-mode column changes (add_columns, drop_columns, rename_columns) are produced from the Columns grid diff; they are not separate fields. Reviewed by tools/review_ui_descriptors.py: column grid record keys; constraints grid split into Primary key / Unique / Foreign keys / Check; parent picker (database). Round trip verified live on TiDB 8.5.6 by tools/tests/test_ui_descriptor_roundtrip_tidb.py (2026-10-29).",
