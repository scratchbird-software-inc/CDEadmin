      "operation_id": "backup_full",
      "resource_kind": "cluster",
      "title": "Back up cluster with BR",
      "menu": {
        "category": "backup_restore"
      },
      "tier": 3,
      "status": "draft",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "storage_uri",
          "label": "Approved BR storage URI",
          "control": "text",
          "required": true
        }
      ],
      "execution_host": true,
      "produces_log": true,
      "notes": "Needs the BR tool and storage every TiKV store can reach; not run against the demo (full restore needs an empty cluster; point-in-time restore needs a log backup), 2026-10-30."
    },
