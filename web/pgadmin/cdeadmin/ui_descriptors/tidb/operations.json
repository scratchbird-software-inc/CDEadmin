        "category": "maintenance"
      },
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "exchange_database",
          "label": "Table database",
          "control": "reference",
          "reference_kind": "database",
          "required": false
        },
        {
          "field_id": "exchange_table",
          "label": "Table",
          "control": "reference",
          "reference_kind": "table",
          "required": true,
          "reference_value": "display_name"
        },
        {
          "field_id": "validation",
          "label": "Validation",
          "control": "select",
          "required": false,
          "default": "WITH",
          "options": [
            {
              "value": "WITH",
              "label": "Validate rows"
            },
            {
              "value": "WITHOUT",
              "label": "Skip validation"
            }
          ]
        }
      ],
      "status": "draft"
