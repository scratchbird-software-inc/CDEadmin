      "tab": "General",
      "control": "boolean",
      "required": false,
      "default": false
    },
    {
      "field_id": "minimum",
      "label": "Minimum",
      "tab": "General",
      "control": "number",
      "required": false,
      "record_key": "catalog_metadata.min_value",
      "visible_when": {
        "field": "no_minimum",
        "equals": false
      }
    },
    {
      "field_id": "no_maximum",
      "label": "No maximum bound (NO MAXVALUE)",
      "tab": "General",
      "control": "boolean",
      "required": false,
      "default": false
    },
    {
      "field_id": "maximum",
      "label": "Maximum",
      "tab": "General",
      "control": "number",
      "required": false,
      "record_key": "catalog_metadata.max_value",
      "visible_when": {
        "field": "no_maximum",
        "equals": false
      }
    },
    {
      "field_id": "cycle",
      "label": "Cycle",
      "tab": "General",
      "control": "boolean",
      "required": false,
      "default": false,
      "record_key": "catalog_metadata.cycle"
    },
    {
      "field_id": "comment",
      "label": "Comment",
      "tab": "General",
      "control": "text",
      "required": false,
      "record_key": "catalog_metadata.comment",
      "visible_when": {
        "field": "clear_comment",
        "truthy": false
      }
    },
    {
      "field_id": "clear_comment",
      "label": "Clear comment",
      "tab": "General",
      "control": "boolean",
      "modes": [
        "alter"
      ],
      "default": false
    },
    {
      "field_id": "reset_state_confirmed",
      "label": "Confirm generator reset on parameter replacement",
      "tab": "Engine",
      "control": "boolean",
      "modes": [
        "alter"
      ],
      "default": false,
      "help": "DuckDB 1.5.2 alters sequence parameters via CREATE OR REPLACE SEQUENCE, which resets last_value to START WITH (comment-only updates preserve last_value)."
    }
  ],
  "notes": "DuckDB 1.5.2 supports CREATE [OR REPLACE] [TEMPORARY] SEQUENCE [IF NOT EXISTS], NO MINVALUE / NO MAXVALUE, CYCLE / NO CYCLE, DROP SEQUENCE [CASCADE], and COMMENT ON SEQUENCE. Comment-only edits preserve generator state; parameter changes compile guarded CREATE OR REPLACE SEQUENCE while preserving sequence comments."
}
