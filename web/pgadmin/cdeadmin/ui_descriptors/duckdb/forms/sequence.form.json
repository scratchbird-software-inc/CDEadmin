      "editable_after_create": false
    },
    {
      "field_id": "parent",
      "label": "Schema",
      "tab": "General",
      "control": "reference",
      "required": false,
      "editable_after_create": false,
      "help": "Target schema in the current DuckDB catalog (defaults to main).",
      "reference_kind": "schema",
      "reference_value": "display_name"
    },
    {
      "field_id": "temporary",
      "label": "Temporary sequence",
      "tab": "General",
      "control": "boolean",
      "modes": [
        "create"
      ],
      "default": false,
      "record_key": "catalog_metadata.temporary",
      "help": "Session-local sequence (CREATE TEMPORARY SEQUENCE)."
    },
    {
      "field_id": "or_replace",
      "label": "Replace if exists (OR REPLACE)",
      "tab": "General",
      "control": "boolean",
      "modes": [
        "create"
      ],
      "default": false,
      "visible_when": {
        "field": "if_not_exists",
        "equals": false
      }
    },
    {
      "field_id": "if_not_exists",
      "label": "Do not error if exists (IF NOT EXISTS)",
      "tab": "General",
      "control": "boolean",
      "modes": [
        "create"
      ],
      "default": false,
      "visible_when": {
        "field": "or_replace",
        "equals": false
      }
    },
    {
      "field_id": "last_value",
      "label": "Last generated value",
      "tab": "General",
      "control": "number",
      "modes": [
        "alter"
      ],
      "readonly": true,
      "record_key": "catalog_metadata.last_value",
      "help": "Current value reported by duckdb_sequences() without advancing the generator (NULL before first nextval)."
    },
    {
      "field_id": "start",
      "label": "Start value",
      "tab": "General",
      "control": "number",
      "required": false,
      "record_key": "catalog_metadata.start_value"
