{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "duckdb",
  "family": "type",
  "resource_kinds": [
    "type"
  ],
  "form_reference": "SR-F-020026",
  "status": "complete",
  "engine_tab_title": "DuckDB",
  "omitted_tabs": [
    {
      "tab": "Security",
      "reason": "no users or privileges"
    }
  ],
  "gaps": [],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true
    },
    {
      "field_id": "parent",
      "label": "Schema",
      "tab": "General",
      "control": "reference",
      "required": false,
      "reference_kind": "schema",
      "reference_value": "display_name",
      "help": "Target DuckDB schema (defaults to main when omitted)."
    },
    {
      "field_id": "type_kind",
      "label": "Type kind",
      "tab": "General",
      "control": "select",
      "required": true,
      "default": "ALIAS",
      "options": [
        {
          "value": "ALIAS",
          "label": "Alias (Scalar / List / Nested Expression)"
        },
        {
          "value": "ENUM",
          "label": "Enum (Closed-Set Dictionary Values)"
        },
        {
          "value": "STRUCT",
          "label": "Struct (Composite Named Fields)"
        },
        {
          "value": "UNION",
          "label": "Union (Tagged Disjoint Alternatives)"
        },
        {
          "value": "ARRAY",
          "label": "Array (Fixed-Length T[N])"
        },
        {
          "value": "MAP",
          "label": "Map (Key-Value MAP(K, V))"
        }
      ]
    },
    {
      "field_id": "or_replace",
      "label": "Replace existing type",
      "tab": "General",
      "control": "boolean",
      "required": false,
      "default": false,
      "modes": [
        "create"
      ],
      "help": "Emits CREATE OR REPLACE TYPE to overwrite an existing type definition."
    },
    {
      "field_id": "temporary",
      "label": "Temporary (session-scoped)",
      "tab": "General",
      "control": "boolean",
      "required": false,
      "default": false,
      "modes": [
        "create"
      ],
      "help": "Emits CREATE TEMPORARY TYPE visible only to the current connection."
    },
    {
      "field_id": "base_type",
      "label": "Alias base type",
      "tab": "General",
      "control": "text",
      "required": true,
      "option_values_path": [
        "dialect",
        "column_types"
      ],
      "visible_when": {
        "field": "type_kind",
        "equals": "ALIAS"
      },
      "help": "Any DuckDB scalar, parameterized, list, or nested type expression (for example DECIMAL(18,4), VARCHAR(64), VARCHAR[], or MAP(VARCHAR, INTEGER))."
    },
    {
      "field_id": "element_type",
      "label": "Element type",
      "tab": "General",
      "control": "text",
      "required": true,
      "option_values_path": [
        "dialect",
        "column_types"
      ],
      "visible_when": {
        "field": "type_kind",
        "equals": "ARRAY"
      },
      "help": "Homogeneous element type for a fixed-size DuckDB ARRAY (for example DOUBLE, FLOAT, INTEGER, VARCHAR)."
    },
    {
      "field_id": "array_length",
      "label": "Array length",
      "tab": "General",
      "control": "number",
      "required": true,
      "default": 4,
      "visible_when": {
        "field": "type_kind",
        "equals": "ARRAY"
      },
      "help": "Fixed element count N >= 1 (compiles <element_type>[N], enforcing exact cardinality)."
    },
    {
      "field_id": "key_type",
      "label": "Map key type",
      "tab": "General",
      "control": "text",
      "required": true,
      "option_values_path": [
        "dialect",
        "column_types"
      ],
      "visible_when": {
        "field": "type_kind",
        "equals": "MAP"
      }
    },
    {
      "field_id": "value_type",
      "label": "Map value type",
      "tab": "General",
      "control": "text",
      "required": true,
      "option_values_path": [
        "dialect",
        "column_types"
      ],
      "visible_when": {
        "field": "type_kind",
        "equals": "MAP"
      }
    },
    {
      "field_id": "comment",
      "label": "Comment",
      "tab": "General",
      "control": "text",
      "required": false,
      "help": "Stored in duckdb_types() via COMMENT ON TYPE."
    },
    {
      "field_id": "enum_values",
      "label": "Enum values",
      "tab": "Constraints",
      "control": "grid",
      "columns": [
        {
          "field_id": "value",
          "label": "Allowed enum literal",
          "control": "text",
          "required": true
        }
      ],
      "required": true,
      "visible_when": {
        "field": "type_kind",
        "equals": "ENUM"
      },
      "item_kind": "string",
      "help": "Dictionary-encoded allowed values enforced natively by DuckDB."
    },
    {
      "field_id": "fields",
      "label": "Struct/union fields",
      "tab": "Constraints",
      "control": "grid",
      "columns": [
        {
          "field_id": "name",
          "label": "Member name",
          "control": "text",
          "required": true
        },
        {
          "field_id": "type",
          "label": "Data type",
          "control": "text",
          "required": true,
          "option_values_path": [
            "dialect",
            "column_types"
          ]
        }
      ],
      "required": true,
      "visible_when": {
        "field": "type_kind",
        "in": [
          "STRUCT",
          "UNION"
        ]
      },
      "help": "Named attributes (STRUCT) or tagged alternatives (UNION), including nested LIST[], ARRAY[N], STRUCT, or MAP types."
    }
  ],
  "notes": "Enterprise DuckDB 1.5 custom type form verified against official DuckDB CREATE TYPE documentation: ALIAS, ENUM, STRUCT, UNION, fixed-length ARRAY (T[N]), MAP(K, V), CREATE OR REPLACE TYPE, CREATE TEMPORARY TYPE, schema selection, and COMMENT ON TYPE."
}
