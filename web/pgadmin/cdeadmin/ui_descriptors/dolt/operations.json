      "tier": 3,
      "status": "draft",
      "confirmation": "typed_name",
      "fields": [
        {
          "field_id": "url",
          "label": "Approved backup URL",
          "control": "text",
          "required": true
        },
        {
          "field_id": "new_database_name",
          "label": "New database name",
          "control": "text",
          "required": true
        },
        {
          "field_id": "force",
          "label": "Replace existing database",
          "control": "boolean",
          "required": false,
          "default": false
        }
      ],
      "execution_host": true,
      "produces_log": true
    },
