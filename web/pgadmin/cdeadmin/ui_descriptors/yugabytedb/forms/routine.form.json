      "options": [
        {
          "value": "function",
          "label": "Function"
        },
        {
          "value": "procedure",
          "label": "Procedure"
        }
      ]
    },
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
