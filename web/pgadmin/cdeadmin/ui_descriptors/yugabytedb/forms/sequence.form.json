{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "yugabytedb",
  "family": "sequence",
  "resource_kinds": [
    "sequence"
  ],
  "status": "complete",
  "engine_tab_title": "YugabyteDB",
  "omitted_tabs": [],
  "gaps": [
    {
      "concept": "Owner, SET SCHEMA, current value (setval)",
      "reason": "Run on 2025.2.2.2 but have no editor yet",
      "tracking": "postgresql-wire-parity"
    }
  ],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true,
      "help": "Renaming runs ALTER SEQUENCE ... RENAME TO."
    },
    {
      "field_id": "parent",
      "label": "Schema",
      "tab": "General",
      "control": "reference",
      "reference_kind": "schema",
      "reference_value": "display_name",
      "editable_after_create": false
    },
    {
      "field_id": "owned_by",
      "label": "Owned by column",
      "tab": "General",
      "control": "text",
      "help": "schema.table.column (OWNED BY); dropping that column drops the sequence. Empty: OWNED BY NONE."
    },
    {
      "field_id": "comment",
      "label": "Comment",
      "tab": "General",
      "control": "text",
      "help": "COMMENT ON SEQUENCE"
    },
    {
      "field_id": "data_type",
      "label": "Type",
      "tab": "General",
      "control": "select",
      "default": "bigint",
      "options": [
        {
          "value": "smallint",
          "label": "smallint"
        },
        {
          "value": "integer",
          "label": "integer"
        },
        {
          "value": "bigint",
          "label": "bigint"
        }
      ],
      "help": "AS type"
    },
    {
      "field_id": "start",
      "label": "Start",
      "tab": "General",
      "control": "number",
      "help": "START WITH"
    },
    {
      "field_id": "increment",
      "label": "Increment",
      "tab": "General",
      "control": "number",
      "help": "INCREMENT BY"
    },
    {
      "field_id": "minimum",
      "label": "Minimum",
      "tab": "General",
      "control": "number",
      "help": "MINVALUE; empty: NO MINVALUE"
    },
    {
      "field_id": "maximum",
      "label": "Maximum",
      "tab": "General",
      "control": "number",
      "help": "MAXVALUE; empty: NO MAXVALUE"
    },
    {
      "field_id": "cache",
      "label": "Cache",
      "tab": "General",
      "control": "number",
      "help": "CACHE: values reserved at a time; YugabyteDB raises a cache below its server minimum (100 on the demo)."
    },
    {
      "field_id": "cycle",
      "label": "Cycle",
      "tab": "General",
      "control": "boolean",
      "default": false,
      "help": "CYCLE: wrap around at the limit."
    },
    {
      "field_id": "restart",
      "label": "Restart with",
      "tab": "General",
      "control": "number",
      "modes": [
        "alter"
      ],
      "help": "RESTART WITH: the next value nextval returns. Leave empty to keep the current value."
    }
  ],
  "notes": "Started from the CockroachDB sequence form (same field ids; YSQL adds cycle and comment, has no cache scope); providers/yugabytedb/sequences.py. The record reads pg_sequences (accurate on YSQL) and OWNED BY from pg_depend. Round trip verified live on YugabyteDB 2025.2.2.2 by tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py (2026-10-30)."
}
