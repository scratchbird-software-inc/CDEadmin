{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "yugabytedb",
  "family": "table",
  "resource_kinds": [
    "table"
  ],
  "status": "complete",
  "engine_tab_title": "YugabyteDB",
  "omitted_tabs": [],
  "gaps": [
    {
      "concept": "Partitions (CREATE TABLE ... PARTITION OF)",
      "reason": "Partitions are inspect-only; a structured bound editor is not built yet",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "Virtual generated columns, EXCLUDE constraints",
      "reason": "Refused by YugabyteDB 2025.2.2.2 (probe)",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "UNLOGGED and temporary tables",
      "reason": "UNLOGGED is ignored with a notice; temporary tables are session-bound, not editor objects",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "Inheritance, LIKE, storage parameters",
      "reason": "Run on 2025.2.2.2 (inheritance is beta) but have no editor yet",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "NOT VALID constraints and VALIDATE",
      "reason": "Run on 2025.2.2.2 but the record does not show validity yet",
      "tracking": "postgresql-wire-parity"
    },
    {
      "concept": "Deferrable unique constraints",
      "reason": "Refused by YugabyteDB 2025.2.2.2 (\"not supported yet\", live); deferrable foreign keys run",
      "tracking": "postgresql-wire-parity"
    }
  ],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "tab": "General",
      "control": "text",
      "required": true,
      "editable_after_create": false
    },
    {
      "field_id": "parent",
      "label": "Schema",
      "tab": "General",
      "control": "reference",
      "required": false,
      "reference_kind": "schema",
      "reference_value": "display_name",
      "editable_after_create": false,
      "help": "Defaults to the session schema (public)."
    },
    {
      "field_id": "comment",
      "label": "Comment",
      "tab": "General",
      "control": "text",
      "required": false,
      "help": "COMMENT ON TABLE"
    },
    {
      "field_id": "columns",
      "label": "Columns",
      "tab": "Columns",
      "control": "grid",
      "required": true,
      "help": "YSQL has no hidden engine columns; every column is listed.",
      "columns": [
        {
          "field_id": "name",
          "label": "Column name",
          "control": "text",
          "required": true
        },
        {
          "field_id": "type",
          "label": "Data type",
          "control": "text",
          "required": true,
          "help": "YSQL type, e.g. varchar(40), numeric(10,2)."
        },
        {
          "field_id": "collation",
          "label": "Collation",
          "control": "text",
          "help": "COLLATE, e.g. C or en-US-x-icu."
        },
        {
          "field_id": "nullable",
          "label": "Nullable",
          "control": "boolean",
          "default": true
        },
        {
          "field_id": "default",
          "label": "Default",
          "control": "text",
          "help": "DEFAULT expression"
        },
        {
          "field_id": "identity",
          "label": "Identity",
          "control": "select",
          "options": [
            {
              "value": "",
              "label": "None"
            },
            {
              "value": "ALWAYS",
              "label": "Always"
            },
            {
              "value": "BY DEFAULT",
              "label": "By default"
            }
          ],
          "help": "GENERATED ... AS IDENTITY; an existing identity can be switched or dropped."
        },
        {
          "field_id": "generated_expression",
          "label": "Generated (stored)",
          "control": "text",
          "help": "GENERATED ALWAYS AS (...) STORED; an existing one can only be dropped (DROP EXPRESSION)."
        },
        {
          "field_id": "unique",
          "label": "Unique",
          "control": "boolean",
          "default": false,
          "editable_after_create": false,
          "record_derive": {
            "cases": [
              {
                "key": "column_key",
                "equals": "UNI",
                "value": true
              }
            ],
            "default": false
          }
        },
        {
          "field_id": "primary_key",
          "label": "Primary key",
          "control": "boolean",
          "default": false,
          "editable_after_create": false,
          "record_derive": {
            "cases": [
              {
                "key": "column_key",
                "equals": "PRI",
                "value": true
              }
            ],
            "default": false
          }
        },
        {
          "field_id": "comment",
          "label": "Comment",
          "control": "text"
        }
      ]
    },
    {
      "field_id": "primary_key",
      "label": "Primary key",
      "tab": "Constraints",
      "group": "Primary key",
      "control": "grid",
      "record_filter": {
        "key": "constraint_type",
        "equals": "PRIMARY KEY"
      },
      "help": "HASH columns lead and are hashed together; the rest are range columns in one order. Changing the key rewrites the table.",
      "columns": [
        {
          "field_id": "name",
          "label": "Name",
          "control": "text"
        },
        {
          "field_id": "columns",
          "label": "Columns",
          "control": "multiselect",
          "required": true,
          "option_values_path": [
            "draft",
            "columns"
          ]
        },
        {
          "field_id": "hash_columns",
          "label": "HASH columns",
          "control": "multiselect",
          "option_values_path": [
            "draft",
            "columns"
          ],
          "help": "The leading columns hashed for sharding; empty: range-sharded."
        },
        {
          "field_id": "order",
          "label": "Range order",
          "control": "select",
          "default": "ASC",
          "options": [
            {
              "value": "ASC",
              "label": "Ascending"
            },
            {
              "value": "DESC",
              "label": "Descending"
            }
          ]
        }
      ]
    },
    {
      "field_id": "unique_constraints",
      "label": "Unique",
      "tab": "Constraints",
      "group": "Unique",
      "control": "grid",
      "record_filter": {
        "key": "constraint_type",
        "equals": "UNIQUE"
      },
      "columns": [
        {
          "field_id": "name",
          "label": "Name",
          "control": "text"
        },
        {
          "field_id": "columns",
          "label": "Columns",
          "control": "multiselect",
          "required": true,
          "option_values_path": [
            "draft",
            "columns"
          ]
        }
      ]
    },
    {
      "field_id": "foreign_keys",
      "label": "Foreign keys",
      "tab": "Constraints",
      "group": "Foreign keys",
      "control": "grid",
      "record_filter": {
        "key": "constraint_type",
        "equals": "FOREIGN KEY"
      },
      "columns": [
        {
          "field_id": "name",
          "label": "Name",
          "control": "text"
        },
        {
          "field_id": "columns",
          "label": "Columns",
          "control": "multiselect",
          "required": true,
          "option_values_path": [
            "draft",
            "columns"
          ]
        },
        {
          "field_id": "references_table",
          "label": "Referenced table",
          "control": "reference",
          "required": true,
          "reference_kind": "table",
          "reference_value": "display_path"
        },
        {
          "field_id": "references_columns",
          "label": "Referenced columns",
          "control": "multiselect",
          "required": true,
          "help": "Columns of the referenced table, in key order."
        },
        {
          "field_id": "on_delete",
          "label": "On delete",
          "control": "select",
          "default": "NO ACTION",
          "options": [
            {
              "value": "NO ACTION",
              "label": "No Action"
            },
            {
              "value": "RESTRICT",
              "label": "Restrict"
            },
            {
              "value": "CASCADE",
              "label": "Cascade"
            },
            {
              "value": "SET NULL",
              "label": "Set Null"
            },
            {
              "value": "SET DEFAULT",
              "label": "Set Default"
            }
          ]
        },
        {
          "field_id": "on_update",
          "label": "On update",
          "control": "select",
          "default": "NO ACTION",
          "options": [
            {
              "value": "NO ACTION",
              "label": "No Action"
            },
            {
              "value": "RESTRICT",
              "label": "Restrict"
            },
            {
              "value": "CASCADE",
              "label": "Cascade"
            },
            {
              "value": "SET NULL",
              "label": "Set Null"
            },
            {
              "value": "SET DEFAULT",
              "label": "Set Default"
            }
          ]
        },
        {
          "field_id": "deferrable",
          "label": "Deferrable",
          "control": "boolean",
          "default": false
        },
        {
          "field_id": "initially_deferred",
          "label": "Initially deferred",
          "control": "boolean",
          "default": false
        }
      ]
    },
    {
      "field_id": "check_constraints",
      "label": "Check",
      "tab": "Constraints",
      "group": "Check",
      "control": "grid",
      "record_filter": {
        "key": "constraint_type",
        "equals": "CHECK"
      },
      "columns": [
        {
          "field_id": "name",
          "label": "Name",
          "control": "text"
        },
        {
          "field_id": "expression",
          "label": "Expression",
          "control": "code",
          "language": "sql",
          "required": true
        }
      ]
    },
    {
      "field_id": "tablespace",
      "label": "Tablespace",
      "tab": "Options",
      "control": "reference",
      "reference_kind": "tablespace",
      "reference_value": "display_name",
      "help": "Replica placement comes from the tablespace; changing it runs ALTER TABLE ... SET TABLESPACE."
    },
    {
      "field_id": "split_into",
      "label": "Split into tablets",
      "tab": "Engine",
      "group": "Sharding",
      "control": "number",
      "min": 1,
      "editable_after_create": false,
      "help": "SPLIT INTO n TABLETS (hash-sharded tables)."
    },
    {
      "field_id": "split_at",
      "label": "Split points",
      "tab": "Engine",
      "group": "Sharding",
      "control": "grid",
      "item_kind": "string",
      "editable_after_create": false,
      "help": "SPLIT AT VALUES, one point per row such as 100 or (10, 'a') (range-sharded tables).",
      "columns": [
        {
          "field_id": "value",
          "label": "Split point",
          "control": "text",
          "required": true
        }
      ]
    },
    {
      "field_id": "colocation",
      "label": "Colocated",
      "tab": "Engine",
      "group": "Sharding",
      "control": "boolean",
      "editable_after_create": false,
      "help": "In a colocated database: off gives the table its own tablets."
    },
    {
      "field_id": "partition_by",
      "label": "Partition by",
      "tab": "Engine",
      "group": "Partitioning",
      "control": "select",
      "editable_after_create": false,
      "options": [
        {
          "value": "",
          "label": "Not partitioned"
        },
        {
          "value": "RANGE",
          "label": "Range"
        },
        {
          "value": "LIST",
          "label": "List"
        },
        {
          "value": "HASH",
          "label": "Hash"
        }
      ]
    },
    {
      "field_id": "partition_key",
      "label": "Partition key",
      "tab": "Engine",
      "group": "Partitioning",
      "control": "text",
      "editable_after_create": false,
      "help": "Columns or expressions, e.g. created_at."
    },
    {
      "field_id": "row_level_security",
      "label": "Row-level security",
      "tab": "Engine",
      "control": "boolean",
      "default": false,
      "help": "ENABLE ROW LEVEL SECURITY: the table's row security policies apply.",
      "group": "Row-level security"
    },
    {
      "field_id": "force_row_level_security",
      "label": "Apply to the owner too",
      "tab": "Engine",
      "control": "boolean",
      "default": false,
      "help": "FORCE ROW LEVEL SECURITY",
      "group": "Row-level security"
    }
  ],
  "notes": "Started from the CockroachDB table form (same field ids); providers/yugabytedb/tables.py. The record reads pg_attribute (format_type, identity, generated, collation, comments), pg_constraint (with deferrability) and the primary key index definition for its HASH shape. Changed cells on existing columns arrive as alter_columns. Round trip verified live on YugabyteDB 2025.2.2.2 by tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py (2026-10-30).",
  "record_children": {
    "columns": {
      "resource_kind": "column"
    },
    "primary_key": {
      "resource_kind": "constraint"
    },
    "unique_constraints": {
      "resource_kind": "constraint"
    },
    "foreign_keys": {
      "resource_kind": "constraint"
    },
    "check_constraints": {
      "resource_kind": "constraint"
    }
  }
}
