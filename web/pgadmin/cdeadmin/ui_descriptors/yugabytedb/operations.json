{
  "schema": "cdeadmin.ui-operations.v1",
  "engine": "yugabytedb",
  "operations": [
    {
      "operation_id": "refresh",
      "resource_kind": "materialized-view",
      "title": "Refresh materialized view",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "complete",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "concurrently",
          "label": "Concurrently",
          "control": "boolean",
          "required": false,
          "default": false,
          "help": "Readers keep the old rows meanwhile; needs a unique index on the materialized view."
        },
        {
          "field_id": "with_data",
          "label": "Fill with data",
          "control": "boolean",
          "required": false,
          "default": true,
          "help": "Off: WITH NO DATA empties it until the next refresh."
        }
      ],
      "notes": "Live round trip (tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py, 2025.2.2.2): plain and concurrent refresh."
    },
    {
      "operation_id": "set_load_balancer",
      "resource_kind": "cluster",
      "title": "Set load balancer state",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "complete",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "enabled",
          "label": "Enabled",
          "control": "boolean",
          "required": true,
          "default": true
        }
      ],
      "notes": "Live round trip (tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py, 2025.2.2.2, one node): load balancer off and on (get_load_balancer_state)."
    },
    {
      "operation_id": "add_blacklist",
      "resource_kind": "node",
      "title": "Drain node replicas",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "confirm",
      "fields": [],
      "notes": "Untested: on the one-node demo the command is accepted but there is no other node to move replicas to."
    },
    {
      "operation_id": "remove_blacklist",
      "resource_kind": "node",
      "title": "Return node replicas",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "confirm",
      "fields": [],
      "notes": "Untested: accepted on the one-node demo; no movement to observe."
    },
    {
      "operation_id": "add_leader_blacklist",
      "resource_kind": "node",
      "title": "Drain node leaders",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "confirm",
      "fields": [],
      "notes": "Untested: accepted on the one-node demo; no other node to take leaders."
    },
    {
      "operation_id": "remove_leader_blacklist",
      "resource_kind": "node",
      "title": "Return node leaders",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "confirm",
      "fields": [],
      "notes": "Untested: accepted on the one-node demo; no movement to observe."
    },
    {
      "operation_id": "configure_placement",
      "resource_kind": "table",
      "title": "Configure table placement",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "complete",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "tablespace",
          "label": "Placement tablespace",
          "control": "text",
          "required": true
        }
      ],
      "notes": "Live round trip (tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py, 2025.2.2.2, one node): table moved onto a placement tablespace."
    },
    {
      "operation_id": "compact",
      "resource_kind": "table",
      "title": "Compact table tablets",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "complete",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "timeout_seconds",
          "label": "Completion timeout (seconds)",
          "control": "number",
          "required": false,
          "default": 20
        },
        {
          "field_id": "include_indexes",
          "label": "Also compact YCQL indexes",
          "control": "boolean",
          "required": false,
          "default": false
        },
        {
          "field_id": "include_vector_indexes",
          "label": "Also compact vector indexes",
          "control": "boolean",
          "required": false,
          "default": false
        }
      ],
      "notes": "Live round trip (tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py, 2025.2.2.2, one node)."
    },
    {
      "operation_id": "flush",
      "resource_kind": "table",
      "title": "Flush table tablets",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "complete",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "timeout_seconds",
          "label": "Completion timeout (seconds)",
          "control": "number",
          "required": false,
          "default": 20
        },
        {
          "field_id": "include_indexes",
          "label": "Also flush YCQL indexes",
          "control": "boolean",
          "required": false,
          "default": false
        }
      ],
      "notes": "Writes the tablets' memory to disk files (SST). A tablet split needs them: without flushed data the master drops a split it accepted (live, 2025.2.2.2). Live round trip (tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py, 2025.2.2.2, one node)."
    },
    {
      "operation_id": "leader_stepdown",
      "resource_kind": "tablet",
      "title": "Step down tablet leader",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "destination_uuid",
          "label": "Destination TServer UUID",
          "control": "text",
          "required": false
        }
      ],
      "notes": "Untested: needs a tablet with another replica (more than one node)."
    },
    {
      "operation_id": "split",
      "resource_kind": "tablet",
      "title": "Split tablet",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "complete",
      "confirmation": "confirm",
      "fields": [],
      "notes": "Asynchronous: yb-admin accepts the split and the master performs it. A tablet with no flushed data (SST files) is not split (live, 2025.2.2.2: \"Either no SST file or too small SST files\"); flush the table first. Live round trip (tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py, 2025.2.2.2, one node): a flushed one-tablet table split into two."
    },
    {
      "operation_id": "leader_stepdown",
      "resource_kind": "master",
      "title": "Step down master leader",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "destination_uuid",
          "label": "Destination master UUID",
          "control": "text",
          "required": false
        }
      ],
      "notes": "Untested: accepted with a single master, which stays leader; needs several masters."
    },
    {
      "operation_id": "configure",
      "resource_kind": "placement-policy",
      "title": "Configure live placement",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "complete",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "placements",
          "label": "Placement blocks",
          "control": "grid",
          "required": true,
          "help": "Where live replicas go (modify_placement_info). The blocks' minimum replicas cannot exceed the replication factor.",
          "columns": [
            {
              "field_id": "cloud",
              "label": "Cloud",
              "control": "text",
              "required": true
            },
            {
              "field_id": "region",
              "label": "Region",
              "control": "text",
              "required": true
            },
            {
              "field_id": "zone",
              "label": "Zone",
              "control": "text",
              "required": true
            },
            {
              "field_id": "min_num_replicas",
              "label": "Minimum replicas",
              "control": "number"
            }
          ]
        },
        {
          "field_id": "replication_factor",
          "label": "Replication factor",
          "control": "number",
          "required": true
        },
        {
          "field_id": "placement_uuid",
          "label": "Placement UUID",
          "control": "text",
          "required": false
        }
      ],
      "notes": "Live round trip (tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py, 2025.2.2.2, one node): the live placement restated."
    },
    {
      "operation_id": "clear",
      "resource_kind": "placement-policy",
      "title": "Clear live placement",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "typed_name",
      "fields": [],
      "notes": "Ran on the demo (clear_placement_info) and left the universe with no live placement until it was configured again; not in a descriptor round trip.",
      "description": "Leaves the universe with no live placement until a placement is configured again."
    },
    {
      "operation_id": "create_database",
      "resource_kind": "snapshot",
      "title": "Create database snapshot",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "complete",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "database",
          "label": "YSQL database",
          "control": "text",
          "required": true
        },
        {
          "field_id": "retention_hours",
          "label": "Retention hours",
          "control": "number",
          "required": false
        }
      ],
      "notes": "Live round trip (tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py, 2025.2.2.2, one node): snapshot reached COMPLETE."
    },
    {
      "operation_id": "restore",
      "resource_kind": "snapshot",
      "title": "Restore snapshot",
      "menu": {
        "category": "backup_restore"
      },
      "tier": 3,
      "status": "complete",
      "confirmation": "typed_name",
      "fields": [
        {
          "field_id": "restore_timestamp",
          "label": "Restore timestamp",
          "control": "text",
          "required": false
        }
      ],
      "execution_host": true,
      "produces_log": true,
      "notes": "Live round trip (tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py, 2025.2.2.2, one node): deleted rows came back."
    },
    {
      "operation_id": "restore",
      "resource_kind": "schedule",
      "title": "Restore snapshot schedule",
      "menu": {
        "category": "backup_restore"
      },
      "tier": 3,
      "status": "complete",
      "confirmation": "typed_name",
      "fields": [
        {
          "field_id": "restore_timestamp",
          "label": "Restore timestamp",
          "control": "text",
          "required": true,
          "help": "YYYY-MM-DD HH:MM:SS within the schedule's retention, in the server's time (UTC on the demo)."
        }
      ],
      "execution_host": true,
      "produces_log": true,
      "notes": "Live round trip (tools/tests/test_ui_descriptor_roundtrip_yugabytedb.py, 2025.2.2.2, one node): point-in-time restore brought deleted rows back."
    },
    {
      "operation_id": "set_enabled",
      "resource_kind": "xcluster-replication",
      "title": "Set xCluster replication state",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "enabled",
          "label": "Enabled",
          "control": "boolean",
          "required": true,
          "default": true
        }
      ],
      "notes": "Untested: needs a second cluster."
    },
    {
      "operation_id": "add_tables",
      "resource_kind": "xcluster-replication",
      "title": "Add xCluster replicated tables",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "confirm",
      "fields": [
        {
          "field_id": "table_ids",
          "label": "Producer table IDs",
          "control": "grid",
          "required": true,
          "item_kind": "string",
          "columns": [
            {
              "field_id": "value",
              "label": "Table ID",
              "control": "text",
              "required": true
            }
          ]
        },
        {
          "field_id": "bootstrap_ids",
          "label": "Producer bootstrap IDs",
          "control": "grid",
          "required": false,
          "item_kind": "string",
          "columns": [
            {
              "field_id": "value",
              "label": "Bootstrap ID",
              "control": "text",
              "required": true
            }
          ]
        }
      ],
      "notes": "Untested: needs a second cluster."
    },
    {
      "operation_id": "remove_tables",
      "resource_kind": "xcluster-replication",
      "title": "Remove xCluster replicated tables",
      "menu": {
        "category": "maintenance"
      },
      "tier": 2,
      "status": "draft",
      "confirmation": "typed_name",
      "fields": [
        {
          "field_id": "table_ids",
          "label": "Producer table IDs",
          "control": "grid",
          "required": true,
          "item_kind": "string",
          "columns": [
            {
              "field_id": "value",
              "label": "Table ID",
              "control": "text",
              "required": true
            }
          ]
        },
        {
          "field_id": "ignore_errors",
          "label": "Ignore missing tables",
          "control": "boolean",
          "required": false,
          "default": false
        }
      ],
      "notes": "Untested: needs a second cluster."
    }
  ]
}
