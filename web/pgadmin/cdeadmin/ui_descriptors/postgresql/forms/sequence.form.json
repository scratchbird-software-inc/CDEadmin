{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "postgresql",
  "family": "sequence",
  "resource_kinds": [
    "sequence"
  ],
  "status": "draft",
  "engine_tab_title": "PostgreSQL",
  "omitted_tabs": [],
  "gaps": [],
  "fields": [
    {
      "field_id": "name",
      "label": "Name",
      "control": "text",
      "tab": "General",
      "required": true
    },
    {
      "field_id": "oid",
      "label": "OID",
      "control": "text",
      "tab": "General",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "help": "Read-only property shown by pgAdmin in properties mode only."
    },
    {
      "field_id": "seqowner",
      "label": "Owner",
      "control": "reference",
      "tab": "General",
      "reference_kind": "role",
      "native_keyword": "OWNER"
    },
    {
      "field_id": "schema",
      "label": "Schema",
      "control": "reference",
      "tab": "General",
      "reference_kind": "schema"
    },
    {
      "field_id": "is_sys_obj",
      "label": "System sequence?",
      "control": "boolean",
      "tab": "General",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "help": "Read-only property shown by pgAdmin in properties mode only."
    },
    {
      "field_id": "comment",
      "label": "Comment",
      "control": "text",
      "tab": "General",
      "native_keyword": "COMMENT ON SEQUENCE"
    },
    {
      "field_id": "current_value",
      "label": "Current value",
      "control": "number",
      "tab": "General",
      "modes": [
        "alter"
      ],
      "native_keyword": "RESTART WITH",
      "help": "Sets the sequence object's current value. The next nextval will return exactly the specified value, and sequence advancement commences with the following nextval."
    },
    {
      "field_id": "increment",
      "label": "Increment",
      "control": "number",
      "tab": "General",
      "native_keyword": "INCREMENT BY"
    },
    {
      "field_id": "start",
      "label": "Start",
      "control": "number",
      "tab": "General",
      "native_keyword": "START WITH"
    },
    {
      "field_id": "minimum",
      "label": "Minimum",
      "control": "number",
      "tab": "General",
      "native_keyword": "MINVALUE"
    },
    {
      "field_id": "maximum",
      "label": "Maximum",
      "control": "number",
      "tab": "General",
      "native_keyword": "MAXVALUE"
    },
    {
      "field_id": "cache",
      "label": "Cache",
      "control": "number",
      "tab": "General",
      "min": 1,
      "native_keyword": "CACHE"
    },
    {
      "field_id": "cycled",
      "label": "Cycled",
      "control": "boolean",
      "tab": "General",
      "native_keyword": "CYCLE"
    },
    {
      "field_id": "relpersistence",
      "label": "Unlogged?",
      "control": "boolean",
      "tab": "Engine",
      "version": {
        "minimum": "15"
      },
      "native_keyword": "UNLOGGED"
    },
    {
      "field_id": "owned_table",
      "label": "Table",
      "control": "reference",
      "tab": "Engine",
      "group": "Owned by",
      "reference_kind": "table",
      "native_keyword": "OWNED BY",
      "help": "The OWNED BY option causes the sequence to be associated with a specific table column, such that if that column (or its whole table) is dropped, the sequence will be automatically dropped as well. The specified table must have the same owner and be in the same schema as the sequence."
    },
    {
      "field_id": "owned_column",
      "label": "Column",
      "control": "select",
      "tab": "Engine",
      "group": "Owned by",
      "option_values_path": [
        "catalog",
        "columns"
      ],
      "visible_when": {
        "field": "owned_table",
        "truthy": true
      },
      "help": "Columns of the selected table (get_columns?tid=owned_table)."
    },
    {
      "field_id": "acl",
      "label": "Privileges",
      "control": "text",
      "tab": "Security",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "help": "Read-only property shown by pgAdmin in properties mode only."
    },
    {
      "field_id": "relacl",
      "label": "Privileges",
      "control": "privileges",
      "tab": "Security",
      "native_keyword": "GRANT",
      "columns": [
        {
          "field_id": "grantee",
          "label": "Grantee",
          "control": "reference",
          "reference_kind": "role",
          "required": true
        },
        {
          "field_id": "privileges",
          "label": "Privileges",
          "control": "multiselect",
          "required": true,
          "option_values_path": [
            "dialect",
            "privileges",
            "sequence"
          ]
        },
        {
          "field_id": "grantor",
          "label": "Grantor",
          "control": "reference",
          "reference_kind": "role",
          "readonly": true
        }
      ],
      "help": "Privilege codes accepted by the backend: r, w, U. Grantee list comes from the role catalog plus PUBLIC; grantor is read-only and defaults to the connected user."
    },
    {
      "field_id": "securities",
      "label": "Security labels",
      "control": "grid",
      "tab": "Security",
      "native_keyword": "SECURITY LABEL",
      "columns": [
        {
          "field_id": "provider",
          "label": "Provider",
          "control": "text"
        },
        {
          "field_id": "label",
          "label": "Security label",
          "control": "text",
          "required": true
        }
      ],
      "version": {
        "minimum": "9.2"
      }
    }
  ],
  "notes": "Fields map 1:1 onto the legacy pgAdmin dialog (workflow legacy_preserved): field ids are the BaseUISchema ids and are served by the existing SQL templates. Source: web/pgadmin/browser/server_groups/servers/databases/schemas/sequences/static/js/sequence.ui.js (SequenceSchema, OwnedBySchema), static/js/privilege.ui.js, static/js/sec_label.ui.js. Mapping by field match: Definition counters->General, Unlogged and Owned By->Engine, Security->Security. Security labels use the pgAdmin id 'securities' (not 'seclabels') on this node. Field ids are checked against the pgAdmin *.ui.js schema ids by tools/tests/test_ui_descriptor_postgresql_schema_ids.py (the schema id gate); the form stays draft until phase 5 routes it to the SQL templates and ports the ui.spec expectations."
}
