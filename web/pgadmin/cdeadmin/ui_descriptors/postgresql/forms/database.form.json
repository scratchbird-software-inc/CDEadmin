        "catalog",
        "collations"
      ],
      "native_keyword": "LC_COLLATE",
      "visible_when": {
        "field": "datlocaleprovider",
        "equals": "libc"
      },
      "help": "Read-only after create."
    },
    {
      "field_id": "datctype",
      "label": "Character type",
      "control": "select",
      "tab": "Options",
      "option_values_path": [
        "catalog",
        "ctypes"
      ],
      "native_keyword": "LC_CTYPE",
      "visible_when": {
        "field": "datlocaleprovider",
        "equals": "libc"
      },
      "help": "Read-only after create."
    },
    {
      "field_id": "datconnlimit",
      "label": "Connection limit",
      "control": "number",
      "tab": "Options",
      "min": -1,
      "default": -1,
      "native_keyword": "CONNECTION LIMIT"
    },
    {
      "field_id": "is_template",
      "label": "Template?",
      "control": "boolean",
      "tab": "Options",
      "native_keyword": "IS_TEMPLATE",
      "help": "Note: When the preferences setting 'show template databases' is set to false, then template databases won't be displayed in the object explorer. Read-only for system databases."
    },
    {
      "field_id": "datallowconn",
      "label": "Allow connections?",
      "control": "boolean",
      "tab": "Options",
      "readonly": true,
      "modes": [
