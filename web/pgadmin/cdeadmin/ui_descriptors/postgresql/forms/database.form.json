{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "postgresql",
  "family": "database",
  "resource_kinds": [
    "database"
  ],
  "status": "draft",
  "engine_tab_title": "PostgreSQL",
  "omitted_tabs": [],
  "gaps": [
    {
      "concept": "Privilege grid in table-like privileges for PG17 (code 'm' MAINTAIN)",
      "reason": "deftblacl uses getPrivilegesForTableAndLikeObjects(version): 'm' only on 17+; the descriptor cannot version-gate a single option inside a multiselect."
    },
    {
      "concept": "Locale fields clear on provider change",
      "reason": "depChange resets datcollate/datctype/daticulocale/daticurules/datbuiltinlocale when datlocaleprovider changes; visible_when hides them but does not clear the value."
    }
  ],
  "fields": [
    {
      "field_id": "name",
      "label": "Database",
      "control": "text",
      "tab": "General",
      "required": true
    },
    {
      "field_id": "did",
      "label": "OID",
      "control": "text",
      "tab": "General",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "help": "Read-only property shown by pgAdmin in properties mode only."
    },
    {
      "field_id": "datoid",
      "label": "OID",
      "control": "number",
      "tab": "General",
      "modes": [
        "create"
      ],
      "min": 16384,
      "version": {
        "minimum": "15"
      },
      "native_keyword": "OID"
    },
    {
      "field_id": "datowner",
      "label": "Owner",
      "control": "reference",
      "tab": "General",
      "reference_kind": "role",
      "native_keyword": "OWNER"
    },
    {
      "field_id": "is_sys_obj",
