{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "postgresql",
  "family": "role",
  "resource_kinds": [
    "role",
    "privilege"
  ],
  "status": "draft",
  "engine_tab_title": "PostgreSQL",
  "omitted_tabs": [],
  "gaps": [
    {
      "concept": "Date-time picker for rolvaliduntil",
      "reason": "no datetime control in the descriptor set; typed text."
    },
    {
      "concept": "Skeleton Privileges tab grid (object grants) and system_privileges/administrator",
      "reason": "pgAdmin's role dialog has no object-grant grid; the 'privilege' resource_kind (variant grant) is handled by the provider's grant wizard, not by role.ui.js. Only the role attribute switches are listed here.",
      "tracking": "ui_unified_design open decisions"
    }
  ],
  "fields": [
    {
      "field_id": "rolname",
      "label": "Name",
      "control": "text",
      "tab": "General",
      "required": true
    },
    {
      "field_id": "oid",
      "label": "OID",
      "control": "text",
      "tab": "General",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "help": "Read-only property shown by pgAdmin in properties mode only."
    },
    {
      "field_id": "is_sys_obj",
      "label": "System role?",
      "control": "boolean",
      "tab": "General",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "help": "Read-only property shown by pgAdmin in properties mode only."
    },
    {
      "field_id": "description",
      "label": "Comments",
      "control": "text",
      "tab": "General",
      "native_keyword": "COMMENT ON ROLE"
    },
    {
      "field_id": "rolpassword",
      "label": "Password",
      "control": "password",
      "tab": "General",
      "native_keyword": "PASSWORD",
      "help": "pgAdmin asks to retype the password (retype: true)."
    },
    {
      "field_id": "rolvaliduntil",
      "label": "Account expires",
      "control": "text",
      "tab": "General",
      "native_keyword": "VALID UNTIL",
      "placeholder": "No Expiry",
      "help": "Please note that if you leave this field blank, then the password will never expire. pgAdmin uses a date-time picker (24h); the descriptor set has no datetime control, so it is typed text (ISO timestamp)."
    },
    {
      "field_id": "rolconnlimit",
      "label": "Connection limit",
      "control": "number",
      "tab": "General",
      "min": -1,
      "default": -1,
      "native_keyword": "CONNECTION LIMIT"
    },
    {
      "field_id": "rolmembership",
      "label": "Member of",
      "control": "grid",
      "tab": "Membership",
      "native_keyword": "GRANT role TO",
      "help": "Roles shown with a check mark have the WITH ADMIN OPTION set. In properties mode pgAdmin renders the same id as formatted text ('role [WITH ADMIN ...]').",
      "columns": [
        {
          "field_id": "role",
          "label": "User/Role",
          "control": "reference",
          "reference_kind": "role",
          "required": true
        },
        {
          "field_id": "admin",
          "label": "WITH ADMIN",
          "control": "boolean",
          "default": false
        },
        {
          "field_id": "inherit",
          "label": "WITH INHERIT",
          "control": "boolean",
          "version": {
            "minimum": "16"
          },
          "default": false
        },
        {
          "field_id": "set",
          "label": "WITH SET",
          "control": "boolean",
          "version": {
            "minimum": "16"
          },
          "default": true
        }
      ]
    },
    {
      "field_id": "rolmembers",
      "label": "Members",
      "control": "grid",
      "tab": "Membership",
      "native_keyword": "GRANT this TO",
      "help": "Roles that are members of this role; same columns and formatting as Member of.",
      "columns": [
        {
          "field_id": "role",
          "label": "User/Role",
          "control": "reference",
          "reference_kind": "role",
          "required": true
        },
        {
          "field_id": "admin",
          "label": "WITH ADMIN",
          "control": "boolean",
          "default": false
        },
        {
          "field_id": "inherit",
          "label": "WITH INHERIT",
          "control": "boolean",
          "version": {
            "minimum": "16"
          },
          "default": false
        },
        {
          "field_id": "set",
          "label": "WITH SET",
          "control": "boolean",
          "version": {
            "minimum": "16"
          },
          "default": true
        }
      ]
    },
    {
      "field_id": "rolcanlogin",
      "label": "Can login?",
      "control": "boolean",
      "tab": "Privileges",
      "native_keyword": "LOGIN",
      "default": false
    },
    {
      "field_id": "rolsuper",
      "label": "Superuser?",
      "control": "boolean",
      "tab": "Privileges",
      "native_keyword": "SUPERUSER",
      "default": false,
      "help": "Switching it on also sets Create roles, Create databases and Bypass RLS (pgAdmin depChange)."
    },
    {
      "field_id": "rolcreaterole",
      "label": "Create roles?",
      "control": "boolean",
      "tab": "Privileges",
      "native_keyword": "CREATEROLE",
      "default": false
    },
    {
      "field_id": "rolcreatedb",
      "label": "Create databases?",
      "control": "boolean",
      "tab": "Privileges",
      "native_keyword": "CREATEDB",
      "default": false
    },
    {
      "field_id": "rolinherit",
      "label": "Inherit rights from the parent roles?",
      "control": "boolean",
      "tab": "Privileges",
      "native_keyword": "INHERIT",
      "default": true
    },
    {
      "field_id": "rolreplication",
      "label": "Can initiate streaming replication and backups?",
      "control": "boolean",
      "tab": "Privileges",
      "native_keyword": "REPLICATION",
      "default": false,
      "version": {
        "minimum": "9.1"
      }
    },
    {
      "field_id": "rolbypassrls",
      "label": "Bypass RLS?",
      "control": "boolean",
      "tab": "Privileges",
      "native_keyword": "BYPASSRLS",
      "default": false
    },
    {
      "field_id": "variables",
      "label": "Configuration parameters",
      "control": "grid",
      "tab": "Engine",
      "native_keyword": "ALTER ... SET",
      "columns": [
        {
          "field_id": "name",
          "label": "Name",
          "control": "select",
          "required": true,
          "option_values_path": [
            "catalog",
            "configuration_parameters"
          ],
          "help": "pgAdmin loads the list from the node's vopts endpoint (pg_settings); the value cell type follows the parameter's vartype (bool/enum/integer/real/string)."
        },
        {
          "field_id": "value",
          "label": "Value",
          "control": "text",
          "required": true
        },
        {
          "field_id": "database",
          "label": "Database",
          "control": "reference",
          "reference_kind": "database"
        }
      ],
      "group": "Parameters"
    },
    {
      "field_id": "seclabels",
      "label": "Security labels",
      "control": "grid",
      "tab": "Engine",
      "native_keyword": "SECURITY LABEL",
      "columns": [
        {
          "field_id": "provider",
          "label": "Provider",
          "control": "text"
        },
        {
          "field_id": "label",
          "label": "Security label",
          "control": "text",
          "required": true
        }
      ],
      "group": "Security",
      "version": {
        "minimum": "9.2"
      }
    }
  ],
  "notes": "Fields map 1:1 onto the legacy pgAdmin dialog (workflow legacy_preserved): field ids are the BaseUISchema ids and are served by the existing SQL templates. Source: web/pgadmin/browser/server_groups/servers/roles/static/js/role.ui.js (RoleSchema), static/js/membership.ui.js, static/js/variable.ui.js (keys name/value/database), static/js/sec_label.ui.js. pgAdmin groups: General/Definition->General, Privileges->Privileges, Membership->Membership; Parameters and Security have no canonical tab on the role family and sit on the Engine tab. Whole-form readOnly (user lacks superuser / createrole and is not editing itself) is a provider authorisation rule, not a field rule."
}
