{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "postgresql",
  "family": "routine",
  "resource_kinds": [
    "function",
    "procedure",
    "aggregate"
  ],
  "status": "draft",
  "engine_tab_title": "PostgreSQL",
  "omitted_tabs": [],
  "gaps": [
    {
      "concept": "Parameters tab holds two grids",
      "reason": "pgAdmin's 'Parameters' group is SET configuration variables while the skeleton's Parameters tab is the argument grid; both are listed on Parameters in separate groups. Decide whether variables move to Options or Engine.",
      "tracking": "ui_unified_design open decisions"
    },
    {
      "concept": "Aggregate create/alter",
      "reason": "AggregateSchema is read-only in pgAdmin (no CREATE AGGREGATE dialog); every aggregate field is readonly."
    },
    {
      "concept": "EDB SPL rules",
      "reason": "isLessThan95ORNonSPL/isLessThan96ORNonSPL disable volatility/strict/cost/leakproof/parallel for procedures unless EDB SPL; ppas is out of beta scope."
    },
    {
      "concept": "Return type control switch",
      "reason": "prorettypename is a select unless customreturn is on, then free text; typed select."
    }
  ],
