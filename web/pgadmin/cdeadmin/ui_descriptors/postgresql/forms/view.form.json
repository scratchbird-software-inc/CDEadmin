{
  "schema": "cdeadmin.ui-form.v1",
  "engine": "postgresql",
  "family": "view",
  "resource_kinds": [
    "view",
    "materialized-view"
  ],
  "status": "draft",
  "engine_tab_title": "PostgreSQL",
  "omitted_tabs": [
    {
      "tab": "Columns",
      "reason": "pgAdmin edits view columns only through the SQL definition."
    }
  ],
  "gaps": [
    {
      "concept": "Skeleton Columns tab (column aliases)",
      "reason": "pgAdmin has no column alias grid for views; aliases are part of the SQL definition."
    },
    {
      "concept": "PG17 MAINTAIN privilege code 'm'",
      "reason": "only offered on 17+ by getPrivilegesForTableAndLikeObjects."
    }
  ],
  "fields": [
    {
      "field_id": "variant",
      "label": "Variant",
      "control": "select",
      "tab": "General",
      "default": "ordinary",
      "required": true,
      "options": [
        {
          "value": "ordinary",
          "label": "View"
        },
        {
          "value": "materialized",
          "label": "Materialized view"
        }
      ],
      "help": "Selects view.ui.js (ordinary) or mview.ui.js (materialized) field set.",
      "ui_only": true
    },
    {
      "field_id": "name",
      "label": "Name",
      "control": "text",
      "tab": "General",
      "required": true
    },
    {
      "field_id": "oid",
      "label": "OID",
      "control": "text",
      "tab": "General",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "help": "Read-only property shown by pgAdmin in properties mode only."
    },
    {
      "field_id": "owner",
      "label": "Owner",
      "control": "reference",
      "tab": "General",
      "reference_kind": "role",
      "native_keyword": "OWNER"
    },
    {
      "field_id": "schema",
      "label": "Schema",
      "control": "reference",
      "tab": "General",
      "reference_kind": "schema"
    },
    {
      "field_id": "system_view",
      "label": "System view?",
      "control": "boolean",
      "tab": "General",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "help": "Read-only property shown by pgAdmin in properties mode only."
    },
    {
      "field_id": "comment",
      "label": "Comment",
      "control": "text",
      "tab": "General",
      "native_keyword": "COMMENT ON VIEW"
    },
    {
      "field_id": "security_barrier",
      "label": "Security barrier?",
      "control": "boolean",
      "tab": "Definition",
      "version": {
        "minimum": "9.2"
      },
      "native_keyword": "security_barrier",
      "visible_when": {
        "field": "variant",
        "equals": "ordinary"
      }
    },
    {
      "field_id": "security_invoker",
      "label": "Security invoker?",
      "control": "boolean",
      "tab": "Definition",
      "version": {
        "minimum": "15"
      },
      "native_keyword": "security_invoker",
      "visible_when": {
        "field": "variant",
        "equals": "ordinary"
      }
    },
    {
      "field_id": "check_option",
      "label": "Check options",
      "control": "select",
      "tab": "Definition",
      "version": {
        "minimum": "9.4"
      },
      "default": "no",
      "options": [
        {
          "value": "no",
          "label": "No"
        },
        {
          "value": "local",
          "label": "Local"
        },
        {
          "value": "cascaded",
          "label": "Cascaded"
        }
      ],
      "native_keyword": "WITH CHECK OPTION",
      "visible_when": {
        "field": "variant",
        "equals": "ordinary"
      }
    },
    {
      "field_id": "with_data",
      "label": "With data?",
      "control": "boolean",
      "tab": "Definition",
      "native_keyword": "WITH DATA",
      "visible_when": {
        "field": "variant",
        "equals": "materialized"
      }
    },
    {
      "field_id": "spcname",
      "label": "Tablespace",
      "control": "select",
      "tab": "Definition",
      "option_values_path": [
        "catalog",
        "tablespaces"
      ],
      "native_keyword": "TABLESPACE",
      "visible_when": {
        "field": "variant",
        "equals": "materialized"
      }
    },
    {
      "field_id": "amname",
      "label": "Access Method",
      "control": "select",
      "tab": "Definition",
      "version": {
        "minimum": "12"
      },
      "option_values_path": [
        "catalog",
        "table_access_methods"
      ],
      "native_keyword": "USING",
      "visible_when": {
        "field": "variant",
        "equals": "materialized"
      },
      "help": "Alterable only on PostgreSQL 15+."
    },
    {
      "field_id": "fillfactor",
      "label": "Fill factor",
      "control": "number",
      "tab": "Definition",
      "min": 10,
      "max": 100,
      "native_keyword": "WITH (fillfactor)",
      "visible_when": {
        "field": "variant",
        "equals": "materialized"
      }
    },
    {
      "field_id": "toast_tuple_target",
      "label": "Toast tuple target",
      "control": "number",
      "tab": "Definition",
      "min": 128,
      "max": 8160,
      "version": {
        "minimum": "11"
      },
      "native_keyword": "toast_tuple_target",
      "visible_when": {
        "field": "variant",
        "equals": "materialized"
      }
    },
    {
      "field_id": "dependsonextensions",
      "label": "Depends on extensions",
      "control": "multiselect",
      "tab": "Definition",
      "version": {
        "minimum": "13"
      },
      "option_values_path": [
        "catalog",
        "extensions"
      ],
      "native_keyword": "ALTER ... DEPENDS ON EXTENSION",
      "visible_when": {
        "field": "variant",
        "equals": "materialized"
      }
    },
    {
      "field_id": "vacuum_settings_str",
      "label": "Storage settings",
      "control": "text",
      "tab": "Definition",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "visible_when": {
        "field": "variant",
        "equals": "materialized"
      },
      "help": "Read-only property shown by pgAdmin in properties mode only."
    },
    {
      "field_id": "definition",
      "label": "Code",
      "control": "code",
      "tab": "Definition",
      "language": "sql",
      "required": true,
      "native_keyword": "AS SELECT",
      "help": "Changing the column list of a view drops and re-creates it (pgAdmin warns); changing a materialized view's definition drops and re-creates it."
    },
    {
      "field_id": "autovacuum_custom",
      "label": "Custom auto-vacuum?",
      "control": "boolean",
      "tab": "Engine",
      "group": "Autovacuum",
      "visible_when": {
        "field": "variant",
        "equals": "materialized"
      }
    },
    {
      "field_id": "autovacuum_enabled",
      "label": "Autovacuum Enabled?",
      "control": "radio",
      "tab": "Engine",
      "group": "Autovacuum",
      "default": "x",
      "options": [
        {
          "value": "x",
          "label": "Not set"
        },
        {
          "value": "t",
          "label": "Yes"
        },
        {
          "value": "f",
          "label": "No"
        }
      ],
      "visible_when": {
        "field": "autovacuum_custom",
        "truthy": true
      }
    },
    {
      "field_id": "vacuum_table",
      "label": "Autovacuum settings",
      "control": "grid",
      "tab": "Engine",
      "group": "Autovacuum",
      "visible_when": {
        "field": "autovacuum_custom",
        "truthy": true
      },
      "help": "Fixed rows (autovacuum_* storage parameters); only Value is editable.",
      "columns": [
        {
          "field_id": "label",
          "label": "Label",
          "control": "text",
          "readonly": true
        },
        {
          "field_id": "value",
          "label": "Value",
          "control": "number"
        },
        {
          "field_id": "setting",
          "label": "Default",
          "control": "text",
          "readonly": true
        }
      ]
    },
    {
      "field_id": "toast_autovacuum",
      "label": "Custom auto-vacuum?",
      "control": "boolean",
      "tab": "Engine",
      "group": "TOAST autovacuum",
      "visible_when": {
        "field": "variant",
        "equals": "materialized"
      }
    },
    {
      "field_id": "toast_autovacuum_enabled",
      "label": "Autovacuum Enabled?",
      "control": "radio",
      "tab": "Engine",
      "group": "TOAST autovacuum",
      "default": "x",
      "options": [
        {
          "value": "x",
          "label": "Not set"
        },
        {
          "value": "t",
          "label": "Yes"
        },
        {
          "value": "f",
          "label": "No"
        }
      ],
      "visible_when": {
        "field": "toast_autovacuum",
        "truthy": true
      }
    },
    {
      "field_id": "vacuum_toast",
      "label": "TOAST autovacuum settings",
      "control": "grid",
      "tab": "Engine",
      "group": "TOAST autovacuum",
      "visible_when": {
        "field": "toast_autovacuum",
        "truthy": true
      },
      "help": "Fixed rows (toast.autovacuum_* parameters); only Value is editable.",
      "columns": [
        {
          "field_id": "label",
          "label": "Label",
          "control": "text",
          "readonly": true
        },
        {
          "field_id": "value",
          "label": "Value",
          "control": "number"
        },
        {
          "field_id": "setting",
          "label": "Default",
          "control": "text",
          "readonly": true
        }
      ]
    },
    {
      "field_id": "acl",
      "label": "Privileges",
      "control": "text",
      "tab": "Security",
      "readonly": true,
      "modes": [
        "alter"
      ],
      "help": "Read-only property shown by pgAdmin in properties mode only."
    },
    {
      "field_id": "datacl",
      "label": "Privileges",
      "control": "privileges",
      "tab": "Security",
      "native_keyword": "GRANT",
      "columns": [
        {
          "field_id": "grantee",
          "label": "Grantee",
          "control": "reference",
          "reference_kind": "role",
          "required": true
        },
        {
          "field_id": "privileges",
          "label": "Privileges",
          "control": "multiselect",
          "required": true,
          "option_values_path": [
            "dialect",
            "privileges",
            "table"
          ]
        },
        {
          "field_id": "grantor",
          "label": "Grantor",
          "control": "reference",
          "reference_kind": "role",
          "readonly": true
        }
      ],
      "help": "Privilege codes accepted by the backend: a, r, w, d, D, x, t, m. Grantee list comes from the role catalog plus PUBLIC; grantor is read-only and defaults to the connected user."
    },
    {
      "field_id": "seclabels",
      "label": "Security labels",
      "control": "grid",
      "tab": "Security",
      "native_keyword": "SECURITY LABEL",
      "columns": [
        {
          "field_id": "provider",
          "label": "Provider",
          "control": "text"
        },
        {
          "field_id": "label",
          "label": "Security label",
          "control": "text",
          "required": true
        }
      ],
      "version": {
        "minimum": "9.2"
      }
    }
  ],
  "notes": "Fields map 1:1 onto the legacy pgAdmin dialog (workflow legacy_preserved): field ids are the BaseUISchema ids and are served by the existing SQL templates. Sources: web/pgadmin/browser/server_groups/servers/databases/schemas/views/static/js/view.ui.js (ViewSchema) and mview.ui.js (MViewSchema, variant materialized), static/js/vacuum.ui.js, static/js/privilege.ui.js, static/js/sec_label.ui.js. Mapping: General->General, Definition->Definition, Code->Definition (definition), mview Parameter nested tab (autovacuum)->Engine, Security->Security. The skeleton's Options fields (check_option, security_barrier, with_data) are kept on Definition to follow the pgAdmin dialog literally."
}
